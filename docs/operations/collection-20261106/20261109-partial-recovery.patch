     'length == 1 and .[0].schemaVersion == 1 and .[0].artifactFormat == "reader-summary-clean-real-day-collection-v1" and .[0].run.collectionDate == $day and .[0].blockingPassed == false and ((.[0].inputs.providerKeys | sort) == ($expected | sort))' \
     "$path" >/dev/null 2>&1
 }
+
+# Recovery-only additional validation; normal admission remains unchanged.
+valid_hn_rss_recovery() {
+  local artifact_mode=$1 artifact_day=$2 artifact_name=$3 coverage=${4:-full} expected artifact_path
+  [[ $coverage == full || ( ( $coverage == partial || $coverage == reconcile-x || $coverage == reconcile-hn-rss ) && $artifact_mode == current-slot ) ]] || return 1
+  [[ $artifact_name =~ ^[a-z0-9-]+$ ]] || return 1
+  artifact_path="/srv/platform/projects/social-monitor/volumes/collection-artifacts/$artifact_name/reader-summary-clean-real-day-collection.$artifact_day.v1.json"
+  [[ -f $artifact_path && ! -L $artifact_path ]] || return 1
+  expected='["github-trending-page","hacker-news","rss"]'
+  [[ $artifact_mode == historical-hn-rss ]] && expected='["hacker-news","rss"]'
+  [[ $artifact_mode != current-slot ]] || expected='["github-trending-page","hacker-news","rss","reddit","x-twitter"]'
+  # Match the pinned product blocking policy against each scan and its exact-day
+  # provider count. Aggregate source/feed row deltas cannot prove coverage.
+  jq -s -e --arg day "$artifact_day" --arg coverage "$coverage" --arg mode "$artifact_mode" --argjson expected "$expected" \
+    '
+    def nonnegative_integer: type == "number" and . >= 0 and floor == .;
+    def positive_integer: type == "number" and . > 0 and floor == .;
+    def fingerprint: type == "string" and test("^[0-9a-f]{8}$");
+    def exact_providers: type == "array" and sort == ($expected | sort);
+    def epoch_millis:
+      if type == "string" and
+         test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$")
+      then . as $timestamp |
+        try ((sub("\\.[0-9]{3}Z$"; "Z") | fromdateiso8601) * 1000 +
+             ($timestamp | capture("\\.(?<millis>[0-9]{3})Z$").millis | tonumber))
+        catch null
+      elif type == "string" and
+           test("^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?[+-][0-9]{2}(:?[0-9]{2})?$")
+      then try (
+        capture("^(?<date>[0-9]{4}-[0-9]{2}-[0-9]{2}) (?<time>[0-9]{2}:[0-9]{2}:[0-9]{2})(\\.(?<fraction>[0-9]{1,6}))?(?<sign>[+-])(?<hour>[0-9]{2})(:?(?<minute>[0-9]{2}))?$") as $parts |
+        ($parts.hour | tonumber) as $hour |
+        (($parts.minute // "0") | tonumber) as $minute |
+        if $hour > 23 or $minute > 59 then null else
+          (($parts.date + "T" + $parts.time + "Z" | fromdateiso8601) * 1000) +
+          ((($parts.fraction // "") + "000")[0:3] | tonumber) -
+          (if $parts.sign == "+" then 1 else -1 end) *
+          (($hour * 60 + $minute) * 60000)
+        end
+      ) catch null
+      else null end;
+    def near($actual; $expected):
+      ($actual | type == "number") and
+      $actual >= $expected - 0.000001 and $actual <= $expected + 0.000001;
+    def scan_passes($report):
+      . as $scan | .providerKey as $provider |
+      .observability as $observation | $observation.slo as $slo |
+      $report.targetWindow.providerCounts[$provider] as $window |
+      $report.targetWindow.newestItemAtByProvider[$provider] as $newest |
+      ($report.run.completedAt | epoch_millis) as $completed |
+      ($report.inputs.targetPublishedWindow.startInclusive | epoch_millis) as $start |
+      ($report.inputs.targetPublishedWindow.endExclusive | epoch_millis) as $end |
+      ($newest | epoch_millis) as $published |
+      (if $completed < $end then $completed else $end end) as $reference |
+      (if $reference != null and $published != null then
+         (($reference - $published) | if . < 0 then 0 else ((. + 500) / 1000 | floor) end)
+       else null end) as $lag |
+      ($window < $observation.targetItemCount) as $short |
+      ($lag != null and $lag > $slo.maxFreshnessLagSeconds) as $stale |
+      ($observation.rateLimitEventCount == 1) as $limited |
+      ($coverage == "partial" and $mode == "current-slot" and
+       $provider == "hacker-news" and $short and $stale) as $stale_hn |
+      ($coverage == "partial" and $mode == "current-slot" and
+       $provider == "x-twitter" and $limited) as $limited_x |
+      ($window | positive_integer) and
+      ($published != null and $start != null and $end != null and
+       $published >= $start and $published < $end and $published <= $reference) and
+      ($observation.targetItemCount | positive_integer) and
+      ($mode != "current-slot" or ($observation.acceptedItemCount | positive_integer)) and
+      ([$observation.collectedItemCount, $observation.acceptedItemCount,
+        $observation.insertedItemCount, $observation.outsideWindowItemCount,
+        $observation.paginationDuplicateItemCount,
+        $observation.storageDuplicateItemCount,
+        $observation.totalDuplicateItemCount] | all(.[]; nonnegative_integer)) and
+      ($observation.collectedItemCount ==
+       $observation.acceptedItemCount + $observation.outsideWindowItemCount) and
+      ($observation.insertedItemCount + $observation.storageDuplicateItemCount <=
+       $observation.acceptedItemCount) and
+      ($observation.totalDuplicateItemCount ==
+       $observation.paginationDuplicateItemCount + $observation.storageDuplicateItemCount) and
+      ($slo.targetItemCount == $observation.targetItemCount) and
+      ($slo.evaluatedItemCount == $window) and
+      ($slo.maxFreshnessLagSeconds | nonnegative_integer and . <= 21600) and
+      (($stale | not) or $stale_hn) and
+      ($observation.freshness.newestAcceptedPublishedAt | epoch_millis) == $published and
+      ($observation.freshness.lagToWindowEndSeconds == $lag) and
+      ($slo.freshnessLagSeconds == $lag) and
+      near($slo.coverageRatio;
+        (if $window < $observation.targetItemCount then
+           $window / $observation.targetItemCount else 1 end)) and
+      (($slo.reasons | type == "array") and
+       ($slo.reasons | sort) ==
+        (((if $short then ["target_shortfall"] else [] end) +
+          (if $stale_hn then ["freshness_lag_exceeded"] else [] end) +
+          (if $limited_x then ["rate_limited"] else [] end)) | sort)) and
+      ($slo.met == (($short or $stale_hn or $limited_x) | not)) and
+      ($slo.retryDisposition ==
+        (if $limited_x then "deferred"
+         elif $short or $stale_hn then "immediate" else "none" end)) and
+      ($scan.status == "succeeded") and
+      ($scan.acquisitionMode == "live_collection") and
+      ($observation.acquisitionMode == "live_collection") and
+      ($scan.bindingFingerprint | fingerprint) and
+      ($scan.attemptCount | positive_integer) and $scan.attemptCount <= 3 and
+      ([$scan.fetched, $scan.inserted, $scan.projected,
+        $scan.skippedDuplicates, $scan.warningCount] | all(.[]; nonnegative_integer)) and
+      ($scan.inserted == $observation.insertedItemCount) and
+      ($scan.skippedDuplicates == $observation.storageDuplicateItemCount) and
+      ($observation.pageCount | positive_integer) and
+      ([$observation.paginationStopReason] |
+       inside(["single_page", "target_items", "no_next_cursor",
+               "cursor_not_advanced", "low_new_item_yield",
+               "high_duplicate_rate", "max_pages", "rate_limited"])) and
+      ($observation.paginationStopReason != "rate_limited" or $limited_x) and
+      (($observation.rateLimitEventCount == 0) or $limited_x) and
+      ($observation.coverageState ==
+        (if $limited_x then "degraded"
+         elif $short then "partial" else "complete" end)) and
+      ($coverage != "full" or
+       $provider == "hacker-news" and
+        $window * 10 >= $observation.targetItemCount * 7 and
+        ($slo.reasons | all(.[]; . == "target_shortfall")) or
+       $provider == "rss" and
+        $window >= $observation.targetItemCount and
+        $slo.met == true and $slo.reasons == [] or
+       $provider == "github-trending-page" and
+        ($observation.collectedItemCount | positive_integer and . >= 10) and
+        $observation.outsideWindowItemCount == 0 and
+        $window >= 10 and
+        ($slo.reasons | all(.[]; . == "target_shortfall")) or
+       ($provider == "reddit" or $provider == "x-twitter") and
+        $window >= $observation.targetItemCount and
+        $slo.met == true and $slo.reasons == []);
+    def unavailable_provider($report; $provider):
+      . as $scan | .observability as $observation | $observation.slo as $slo |
+      ($coverage == "reconcile-x" or $coverage == "reconcile-hn-rss") and $mode == "current-slot" and
+      $scan.providerKey == $provider and $scan.status == "failed" and
+      $scan.acquisitionMode == "live_collection" and
+      $scan.attemptCount == 3 and
+      ($scan.failureFingerprint | type == "string" and test("^[0-9a-f]{8}$")) and
+      ([$scan.fetched, $scan.inserted, $scan.projected,
+        $scan.skippedDuplicates] | all(.[]; . == 0)) and
+      ($scan.warningCount | nonnegative_integer) and
+      $observation.acquisitionMode == "live_collection" and
+      $observation.failureKind == "unavailable" and
+      $observation.coverageState == "unavailable" and
+      ($observation.targetItemCount | positive_integer) and
+      ([$observation.collectedItemCount, $observation.acceptedItemCount,
+        $observation.insertedItemCount, $observation.outsideWindowItemCount,
+        $observation.paginationDuplicateItemCount,
+        $observation.storageDuplicateItemCount,
+        $observation.totalDuplicateItemCount, $observation.pageCount,
+        $observation.rateLimitEventCount] | all(.[]; . == 0)) and
+      $observation.paginationStopReason == "failed" and
+      $observation.freshness == {} and
+      $slo.met == false and
+      $slo.targetItemCount == $observation.targetItemCount and
+      $slo.evaluatedItemCount == 0 and $slo.coverageRatio == 0 and
+      ($slo.maxFreshnessLagSeconds | nonnegative_integer and . <= 21600) and
+      $slo.reasons == ["target_shortfall", "provider_unavailable"] and
+      $slo.retryDisposition == "immediate" and
+      ($report.targetWindow.providerCounts | has($provider) | not) and
+      ($report.targetWindow.newestItemAtByProvider | has($provider) | not);
+    def empty_rss($report):
+      . as $scan | .observability as $o | $o.slo as $s |
+      $scan.providerKey == "rss" and $scan.status == "succeeded" and
+      $scan.acquisitionMode == "live_collection" and $scan.attemptCount == 3 and
+      ([$scan.fetched, $scan.inserted, $scan.projected, $scan.skippedDuplicates] | all(.[]; . == 0)) and
+      ($scan.warningCount | nonnegative_integer) and $o.acquisitionMode == "live_collection" and
+      ($o.targetItemCount | positive_integer) and
+      ([$o.collectedItemCount, $o.acceptedItemCount, $o.insertedItemCount,
+        $o.outsideWindowItemCount, $o.paginationDuplicateItemCount, $o.storageDuplicateItemCount,
+        $o.totalDuplicateItemCount, $o.rateLimitEventCount] | all(.[]; . == 0)) and
+      $o.pageCount == 1 and $o.paginationStopReason == "single_page" and
+      $o.coverageState == "unavailable" and $o.freshness == {} and
+      $s.met == false and $s.targetItemCount == $o.targetItemCount and
+      $s.evaluatedItemCount == 0 and $s.coverageRatio == 0 and
+      ($s.maxFreshnessLagSeconds | nonnegative_integer and . <= 21600) and
+      $s.reasons == ["target_shortfall"] and $s.retryDisposition == "immediate" and
+      ($report.targetWindow.providerCounts | has("rss") | not) and
+      ($report.targetWindow.newestItemAtByProvider | has("rss") | not);
+    length == 1 and (.[0] | . as $report |
+      ([.scans[] | select(.providerKey == "x-twitter" and .status == "failed")] | length == 1) as $x_failed |
+      .schemaVersion == 1 and
+      .artifactFormat == "reader-summary-clean-real-day-collection-v1" and
+      .generatedBy == "npm run run:reader-summary-clean-real-day-collection" and
+      .run.collectionDate == $day and
+      (if $mode == "current-slot" then
+         (.run.startedAt | type == "string" and
+          test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$")) and
+         (.run.completedAt | type == "string" and
+          test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$")) and
+         ((.run.startedAt | epoch_millis) >= (.inputs.targetPublishedWindow.startInclusive | epoch_millis)) and
+         ((.run.startedAt | epoch_millis) <= (.run.completedAt | epoch_millis)) and
+         ((.run.completedAt | epoch_millis) < (.inputs.targetPublishedWindow.endExclusive | epoch_millis))
+       else true end) and
+      ($coverage != "reconcile-x" or $x_failed) and
+      ($coverage != "reconcile-hn-rss" or ([.scans[] | select(.providerKey == "hacker-news" and .status == "failed")] | length == 1)) and
+      .blockingPassed == ($coverage == "full") and
+      .inputs.database == "local-postgres" and
+      .inputs.targetPublishedWindow.startInclusive == ($day + "T00:00:00.000Z") and
+      (.inputs.targetPublishedWindow.endExclusive ==
+        ((($day + "T00:00:00.000Z" | epoch_millis) + 86400000) / 1000 |
+         todateiso8601 | sub("Z$"; ".000Z"))) and
+      (.run.completedAt | epoch_millis) != null and
+      (.inputs.providerKeys | exact_providers) and
+      (if $mode == "current-slot" then
+         (.model.liveNetwork == true and
+          (.model.liveNetworkProviderKeys | exact_providers) and
+          .model.durableSnapshotReuseProviderKeys == [] and
+          (.targetWindow.providerCounts | keys | sort ==
+           (if $coverage == "reconcile-x" then
+              ($expected - ["x-twitter"] | sort) elif $coverage == "reconcile-hn-rss" then
+              ($expected - ["hacker-news", "rss"] | sort) else ($expected | sort) end)) and
+          (.targetWindow.newestItemAtByProvider | keys | sort ==
+           (if $coverage == "reconcile-x" then
+              ($expected - ["x-twitter"] | sort) elif $coverage == "reconcile-hn-rss" then
+              ($expected - ["hacker-news", "rss"] | sort) else ($expected | sort) end)))
+       else true end) and
+      ([.targets[]?.providerKey] | exact_providers) and
+      ([.scans[]?.providerKey] | exact_providers) and
+      (.targets | all(.[]; (.bindingFingerprint | fingerprint) and
+        (.interestFingerprint | fingerprint) and
+        (.workspaceFingerprint | fingerprint))) and
+      (.scans | all(.[]; . as $scan |
+        any($report.targets[]; .providerKey == $scan.providerKey and
+          .bindingFingerprint == $scan.bindingFingerprint))) and
+      (.qualityGates.everyRequestedProviderSucceeded == (if $coverage == "reconcile-x" or $coverage == "reconcile-hn-rss" then false else true end) and
+       .qualityGates.everyRequestedProviderHasTargetItems == (if $coverage == "reconcile-x" or $coverage == "reconcile-hn-rss" then false else true end) and
+       .qualityGates.everyRequestedProviderMeetsBlockingCoveragePolicy == ($coverage == "full") and
+       .qualityGates.providerCollectionObservabilityComplete == true and
+       .qualityGates.partialProviderCoverageIsExplicit == true) and
+      (.qualityGates | to_entries | all(.[];
+        if .key == "everyRequestedProviderMeetsBlockingCoveragePolicy" then
+          .value == ($coverage == "full")
+        elif .key == "everyRequestedProviderSucceeded" or .key == "everyRequestedProviderHasTargetItems" then
+          .value == ($coverage != "reconcile-x" and $coverage != "reconcile-hn-rss")
+        else .value == true end)) and
+      (if $coverage == "partial" then
+        any(.scans[]; .observability.slo.met == false and
+          (.observability.coverageState == "partial" or
+           .observability.coverageState == "degraded"))
+       else true end) and
+      (.scans | all(.[];
+        if .providerKey == "x-twitter" and .status == "failed" then
+          unavailable_provider($report; "x-twitter")
+        elif $coverage == "reconcile-hn-rss" and .providerKey == "hacker-news" then
+          unavailable_provider($report; "hacker-news")
+        elif $coverage == "reconcile-hn-rss" and .providerKey == "rss" then
+          empty_rss($report)
+        else scan_passes($report) end)))
+    ' \
+    "$artifact_path" >/dev/null 2>&1
+}
