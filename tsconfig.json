{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "incremental": true,
    "strict": true,
    "strictPropertyInitialization": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node", "jest"],
    "paths": {
      "@social-monitor/shared-kernel": ["libs/shared-kernel/src/index.ts"],
      "@social-monitor/platform-config": ["libs/platform/config/src/index.ts"],
      "@social-monitor/platform-events": ["libs/platform/events/src/index.ts"],
      "@social-monitor/platform-events/*": ["libs/platform/events/src/*"],
      "@social-monitor/platform-grpc": ["libs/platform/grpc/src/index.ts"],
      "@social-monitor/platform-logging": ["libs/platform/logging/src/index.ts"],
      "@social-monitor/platform-metrics": ["libs/platform/metrics/src/index.ts"],
      "@social-monitor/platform-persistence": ["libs/platform/persistence/src/index.ts"],
      "@social-monitor/platform-persistence/prisma-runtime-client": [
        "libs/platform/persistence/src/prisma-runtime-client.ts"
      ],
      "@social-monitor/platform-queue": ["libs/platform/queue/src/index.ts"],
      "@social-monitor/platform-queue/*": ["libs/platform/queue/src/*"],
      "@social-monitor/platform-request-context": ["libs/platform/request-context/src/index.ts"],
      "@social-monitor/platform-worker": ["libs/platform/worker/src/index.ts"],
      "@social-monitor/contracts/*": ["libs/contracts/*"],
      "@social-monitor/conversation": ["libs/conversation/index.ts"],
      "@social-monitor/conversation/*": ["libs/conversation/*"],
      "@social-monitor/identity/*": ["libs/identity/*"],
      "@social-monitor/launch/*": ["libs/launch/*"],
      "@social-monitor/monitoring/*": ["libs/monitoring/*"],
      "@social-monitor/ingestion/*": ["libs/ingestion/*"],
      "@social-monitor/privacy/*": ["libs/privacy/*"],
      "@social-monitor/feed": ["libs/feed/index.ts"],
      "@social-monitor/feed/*": ["libs/feed/*"],
      "@social-monitor/relevance/*": ["libs/relevance/*"],
      "@social-monitor/social-research": ["libs/social-research/index.ts"],
      "@social-monitor/social-research/*": ["libs/social-research/*"],
      "@social-monitor/summary/*": ["libs/summary/*"],
      "@social-monitor/subscriptions/*": ["libs/subscriptions/*"],
      "@social-monitor/delivery/*": ["libs/delivery/*"],
      "@social-monitor/usage/*": ["libs/usage/*"]
    }
  },
  "exclude": ["node_modules", "dist", "coverage", "prisma/generated"]
}
