{
  "schemaVersion": 1,
  "alertSetId": "mvp-alerts",
  "owner": "platform",
  "alerts": [
    {
      "alertId": "scan-queue-backlog-growing",
      "severity": "warning",
      "metric": "queue_commands_backlog",
      "labels": {
        "command_type": "ingestion.scan.execute",
        "queue": "scan"
      },
      "condition": "latest_value >= 10 for 10m",
      "dashboardId": "mvp-health",
      "dashboardPanelId": "scan-queue-backlog",
      "runbook": "docs/iterations/06-production-hardening/12-operational-runbook.md#queue-backlog-triage",
      "userVisibleState": "scan_in_progress_or_scan_degraded",
      "firstMitigation": "inspect_worker_availability_before_increasing_scan_frequency",
      "page": false
    },
    {
      "alertId": "scan-worker-failures",
      "severity": "warning",
      "metric": "scan_jobs_total",
      "labels": {
        "job_type": "scan",
        "status": "failed",
        "worker": "ingestion-worker"
      },
      "condition": "increase >= 3 for 10m",
      "dashboardId": "mvp-health",
      "dashboardPanelId": "scan-worker-failed",
      "runbook": "docs/iterations/06-production-hardening/12-operational-runbook.md#scan-status-triage",
      "userVisibleState": "scan_degraded",
      "firstMitigation": "classify_failure_before_retrying_or_scaling_workers",
      "page": false
    },
    {
      "alertId": "scan-queue-lag-high",
      "severity": "warning",
      "metric": "queue_command_delivery_lag_seconds",
      "labels": {
        "command_type": "ingestion.scan.execute",
        "queue": "scan",
        "worker": "ingestion-worker"
      },
      "condition": "latest_value >= 300 for 10m",
      "dashboardId": "mvp-health",
      "dashboardPanelId": "scan-queue-lag",
      "runbook": "docs/iterations/06-production-hardening/12-operational-runbook.md#queue-backlog-triage",
      "userVisibleState": "scan_in_progress_or_scan_degraded",
      "firstMitigation": "inspect_worker_availability_and_provider_pressure_before_scaling",
      "page": false
    },
    {
      "alertId": "scan-dlq-growth",
      "severity": "warning",
      "metric": "scan_failure_queue_backlog",
      "labels": {
        "queue": "scan-dlq"
      },
      "condition": "latest_value >= 1 for 5m",
      "dashboardId": "mvp-health",
      "dashboardPanelId": "scan-dlq-backlog",
      "runbook": "docs/iterations/06-production-hardening/12-operational-runbook.md#dlq-triage",
      "userVisibleState": "scan_degraded",
      "firstMitigation": "classify_dead_letter_before_replay_or_suppression",
      "safeDiagnosticFields": ["scan_id", "source_binding_id", "failure_class", "correlation_id"],
      "page": false
    },
    {
      "alertId": "summary-queue-backlog-growing",
      "severity": "warning",
      "metric": "queue_commands_backlog",
      "labels": {
        "command_type": "summary.job.execute",
        "queue": "summary"
      },
      "condition": "latest_value >= 10 for 10m",
      "dashboardId": "mvp-health",
      "dashboardPanelId": "summary-queue-backlog",
      "runbook": "docs/iterations/06-production-hardening/12-operational-runbook.md#queue-backlog-triage",
      "userVisibleState": "summary_degraded",
      "firstMitigation": "inspect_intelligence_worker_availability_before_replaying_summary_jobs",
      "page": false
    },
    {
      "alertId": "summary-queue-lag-high",
      "severity": "warning",
      "metric": "queue_command_delivery_lag_seconds",
      "labels": {
        "command_type": "summary.job.execute",
        "queue": "summary",
        "worker": "intelligence-worker"
      },
      "condition": "latest_value >= 300 for 10m",
      "dashboardId": "mvp-health",
      "dashboardPanelId": "summary-queue-lag",
      "runbook": "docs/iterations/06-production-hardening/12-operational-runbook.md#queue-backlog-triage",
      "userVisibleState": "summary_degraded",
      "firstMitigation": "inspect_intelligence_worker_availability_and_model_pressure_before_replaying",
      "page": false
    },
    {
      "alertId": "delivery-queue-backlog-growing",
      "severity": "warning",
      "metric": "queue_commands_backlog",
      "labels": {
        "command_type": "delivery.attempt.send",
        "queue": "delivery"
      },
      "condition": "latest_value >= 10 for 10m",
      "dashboardId": "mvp-health",
      "dashboardPanelId": "delivery-queue-backlog",
      "runbook": "docs/iterations/06-production-hardening/12-operational-runbook.md#queue-backlog-triage",
      "userVisibleState": "delivery_degraded",
      "firstMitigation": "inspect_delivery_worker_availability_before_replaying_delivery_attempts",
      "page": false
    },
    {
      "alertId": "delivery-queue-lag-high",
      "severity": "warning",
      "metric": "queue_command_delivery_lag_seconds",
      "labels": {
        "command_type": "delivery.attempt.send",
        "queue": "delivery",
        "worker": "delivery-service"
      },
      "condition": "latest_value >= 300 for 10m",
      "dashboardId": "mvp-health",
      "dashboardPanelId": "delivery-queue-lag",
      "runbook": "docs/iterations/06-production-hardening/12-operational-runbook.md#queue-backlog-triage",
      "userVisibleState": "delivery_degraded",
      "firstMitigation": "inspect_delivery_worker_availability_and_endpoint_failures_before_replaying",
      "page": false
    },
    {
      "alertId": "provider-unavailable-scan-failures",
      "severity": "warning",
      "metric": "scan_failures_total",
      "labels": {
        "failure_class": "provider_unavailable",
        "job_type": "scan",
        "worker": "ingestion-worker"
      },
      "condition": "increase >= 3 for 10m",
      "dashboardId": "mvp-health",
      "dashboardPanelId": "provider-unavailable-failures",
      "runbook": "docs/iterations/06-production-hardening/12-operational-runbook.md#provider-failure-triage",
      "userVisibleState": "scan_degraded",
      "firstMitigation": "check_provider_health_before_replaying_scans",
      "safeDiagnosticFields": ["provider_key", "source_binding_id", "failure_class", "correlation_id"],
      "page": false
    },
    {
      "alertId": "provider-rate-limit-scan-failures",
      "severity": "warning",
      "metric": "scan_failures_total",
      "labels": {
        "failure_class": "provider_rate_limited",
        "job_type": "scan",
        "worker": "ingestion-worker"
      },
      "condition": "increase >= 1 for 5m",
      "dashboardId": "mvp-health",
      "dashboardPanelId": "provider-rate-limit-failures",
      "runbook": "docs/iterations/06-production-hardening/12-operational-runbook.md#provider-failure-triage",
      "userVisibleState": "scan_degraded",
      "firstMitigation": "reduce_scan_frequency_before_adding_workers",
      "safeDiagnosticFields": ["provider_key", "source_binding_id", "failure_class", "correlation_id"],
      "page": false
    },
    {
      "alertId": "summary-model-cost-spike",
      "severity": "warning",
      "metric": "summary_model_estimated_cost_usd",
      "labels": {
        "model": "summary-fake-v1",
        "provider": "deterministic-local"
      },
      "condition": "increase >= 1 for 30m",
      "dashboardId": "mvp-health",
      "dashboardPanelId": "summary-model-cost",
      "runbook": "docs/iterations/06-production-hardening/12-operational-runbook.md#summary-cost-triage",
      "userVisibleState": "summary_degraded",
      "firstMitigation": "check_model_route_and_quota_before_retrying_summaries",
      "safeDiagnosticFields": ["provider", "model", "tenant_id", "workspace_id", "correlation_id"],
      "page": false
    },
    {
      "alertId": "summary-story-ranking-cross-provider-share-low",
      "severity": "warning",
      "metric": "summary_story_ranking_cross_provider_cluster_share",
      "labels": {
        "ranking_policy_version": "story_ranking_v1"
      },
      "condition": "latest_value <= 0.2 for 30m",
      "dashboardId": "mvp-health",
      "dashboardPanelId": "summary-story-ranking-cross-provider-share",
      "runbook": "docs/iterations/06-production-hardening/12-operational-runbook.md#summary-quality-triage",
      "userVisibleState": "summary_quality_degraded",
      "firstMitigation": "check_provider_coverage_before_tuning_ranking_weights",
      "safeDiagnosticFields": ["ranking_policy_version", "tenant_id", "workspace_id", "correlation_id"],
      "page": false
    },
    {
      "alertId": "summary-story-ranking-title-only-clusters-high",
      "severity": "warning",
      "metric": "summary_story_ranking_title_only_cluster_share",
      "labels": {
        "ranking_policy_version": "story_ranking_v1"
      },
      "condition": "latest_value >= 0.35 for 30m",
      "dashboardId": "mvp-health",
      "dashboardPanelId": "summary-story-ranking-title-only-share",
      "runbook": "docs/iterations/06-production-hardening/12-operational-runbook.md#summary-quality-triage",
      "userVisibleState": "summary_quality_degraded",
      "firstMitigation": "inspect_canonical_urls_before_accepting_title_only_merges",
      "safeDiagnosticFields": ["ranking_policy_version", "tenant_id", "workspace_id", "correlation_id"],
      "page": false
    },
    {
      "alertId": "summary-story-ranking-missing-provider-metrics",
      "severity": "warning",
      "metric": "summary_story_ranking_clusters_without_provider_metrics",
      "labels": {
        "ranking_policy_version": "story_ranking_v1"
      },
      "condition": "latest_value >= 1 for 30m",
      "dashboardId": "mvp-health",
      "dashboardPanelId": "summary-story-ranking-missing-provider-metrics",
      "runbook": "docs/iterations/06-production-hardening/12-operational-runbook.md#summary-quality-triage",
      "userVisibleState": "summary_quality_degraded",
      "firstMitigation": "check_provider_metric_mapping_before_shipping_reader_ranking",
      "safeDiagnosticFields": ["ranking_policy_version", "tenant_id", "workspace_id", "correlation_id"],
      "page": false
    },
    {
      "alertId": "summary-story-ranking-provider-domination",
      "severity": "warning",
      "metric": "summary_story_ranking_top_provider_cluster_share",
      "labels": {
        "ranking_policy_version": "story_ranking_v1",
        "top_provider_key": "unknown"
      },
      "condition": "latest_value >= 0.8 for 30m",
      "dashboardId": "mvp-health",
      "dashboardPanelId": "summary-story-ranking-provider-domination",
      "runbook": "docs/iterations/06-production-hardening/12-operational-runbook.md#summary-quality-triage",
      "userVisibleState": "summary_quality_degraded",
      "firstMitigation": "check_source_mix_before_boosting_single_provider_signals",
      "safeDiagnosticFields": ["ranking_policy_version", "top_provider_key", "tenant_id", "workspace_id", "correlation_id"],
      "page": false
    },
    {
      "alertId": "webhook-delivery-failures",
      "severity": "warning",
      "metric": "delivery_failures_total",
      "labels": {
        "channel": "webhook",
        "resource_type": "digest",
        "retryable": "true"
      },
      "condition": "increase >= 3 for 15m",
      "dashboardId": "mvp-health",
      "dashboardPanelId": "delivery-webhook-failures",
      "runbook": "docs/iterations/06-production-hardening/12-operational-runbook.md#delivery-failure-triage",
      "userVisibleState": "delivery_degraded",
      "firstMitigation": "check_webhook_endpoint_status_before_replaying_delivery_attempts",
      "safeDiagnosticFields": ["attempt_id", "channel", "resource_type", "correlation_id"],
      "page": false
    }
  ]
}
