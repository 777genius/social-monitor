  "tenantScopedSystemTables": [
    {
      "table": "idempotency_keys",
      "tenantIdRequired": false,
      "workspaceIdRequired": false,
      "tenantPrefixedIndexRequired": true,
      "reason": "Some internal idempotency scopes are global, but tenant/workspace scoped write commands must be indexed by tenant and workspace."
    },
    {
      "table": "inbox_records",
      "tenantIdRequired": false,
      "workspaceIdRequired": false,
      "tenantPrefixedIndexRequired": true,
      "reason": "Platform inbox entries can represent global events, but tenant event dedupe must remain tenant-queryable."
    },
    {
      "table": "outbox_events",
      "tenantIdRequired": false,
      "workspaceIdRequired": false,
      "tenantPrefixedIndexRequired": true,
      "reason": "Platform outbox can emit global events, but tenant event dispatch and support triage must remain tenant-queryable."
    }
  ],
  "indirectTenantOwnedTables": [
    {
      "table": "source_credential_secrets",
      "parentTable": "source_credentials",
      "reason": "Encrypted source credential material is readable and mutable only through a tenant-scoped source credential reference."
    },
    {
      "table": "webhook_replay_deliveries",
      "parentTable": "webhook_endpoints",
      "reason": "Webhook replay nonces inherit tenant scope from their endpoint."
    }
  ],
  "tenantScopedAssociations": [
    {
      "childTable": "webhook_endpoints",
      "parentTable": "webhook_secrets",
      "constraintName": "webhook_endpoints_secret_scope_fkey",
      "childColumns": [
        "secret_key_id",
        "tenant_id",
        "workspace_id"
      ],
      "parentColumns": [
        "id",
        "tenant_id",
        "workspace_id"
      ],
      "reason": "An endpoint can reference signing material only when both rows have exactly the same tenant and workspace ownership."
    }
  ],
  "sharedTables": [
    {
      "table": "capability_profiles",
      "reason": "Versioned source capability metadata is shared reference data."
    },
    {
      "table": "rate_limit_buckets",
      "reason": "Rate limit buckets are keyed by opaque subject and operation; tenant-specific quotas live in usage_quota_buckets."
    },
    {
      "table": "source_catalog_entries",
      "reason": "Source catalog metadata is shared reference data."
    }
  ]
