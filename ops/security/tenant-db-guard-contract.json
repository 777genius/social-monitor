    },
    {
      "table": "idempotency_keys",
      "tenantIdRequired": false,
      "workspaceIdRequired": false,
      "tenantPrefixedIndexRequired": true,
      "reason": "Some internal idempotency scopes are global, but tenant/workspace scoped write commands must be indexed by tenant and workspace."
    },
    {
      "table": "inbox_records",
      "tenantIdRequired": false,
      "workspaceIdRequired": false,
      "tenantPrefixedIndexRequired": true,
      "reason": "Platform inbox entries can represent global events, but tenant event dedupe must remain tenant-queryable."
    },
    {
      "table": "outbox_events",
      "tenantIdRequired": false,
      "workspaceIdRequired": false,
      "tenantPrefixedIndexRequired": true,
      "reason": "Platform outbox can emit global events, but tenant event dispatch and support triage must remain tenant-queryable."
