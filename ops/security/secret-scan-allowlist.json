{
  "schemaVersion": 1,
  "allowedLiteralValues": [
    "password",
    "raw-password",
    "raw-token",
    "local-dev-token",
    "social_monitor_local_password",
    "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
    "API",
    "invalid",
    "smk_secret",
    "smk_key",
    "smk_abc123",
    "smk_visible_",
    "smk_test_123",
    "smk_id-1_id",
    "smk_id-1_id-2",
    "smk_live_123",
    "whsec_secret",
    "whsec_abc123",
    "whsec_...1234",
    "whsec_key_"
  ],
  "allowedValuePrefixes": [
    "smk_${",
    "whsec_${",
    "whsec_key_${"
  ],
  "allowedValuePatterns": [
    "^(?:JWT|OIDC|authorization)$",
    "^jwt\\.header\\.signature$",
    "^token-value$",
    "^smk_(?:test|fake|generated)[A-Za-z0-9._-]*$",
    "^whsec_(?:test|fake|generated)[A-Za-z0-9._-]*$"
  ],
  "ignoredPaths": [
    "dist/",
    "node_modules/",
    "prisma/generated/"
  ]
}
