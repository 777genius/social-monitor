      "table": "tenants",
      "dataClass": "tenant_account",
      "owner": "platform-owner",
      "retentionDays": 2555,
      "deleteMode": "soft_delete_then_hard_delete",
      "exportable": true,
      "legalHoldAware": true,
      "purgeTrigger": "tenant_offboarding_completed"
    },
    {
      "table": "workspaces",
      "dataClass": "tenant_workspace",
      "owner": "platform-owner",
      "retentionDays": 2555,
      "deleteMode": "soft_delete_then_hard_delete",
      "exportable": true,
      "legalHoldAware": true,
      "purgeTrigger": "tenant_or_workspace_offboarding_completed"
    },
    {
      "table": "users",
      "dataClass": "user_profile",
      "owner": "identity-owner",
      "retentionDays": 2555,
      "deleteMode": "soft_delete_then_anonymize",
      "exportable": true,
      "legalHoldAware": true,
      "purgeTrigger": "dsar_delete_or_tenant_offboarding_completed"
