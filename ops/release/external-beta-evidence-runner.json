        "JWKS_URL"
      ],
      "outputArtifacts": [
        {
          "path": "ops/release/durable-runtime-proof.json",
          "format": "durable-runtime-proof-contract-v1"
        },
        {
          "env": "DURABLE_RUNTIME_SELECTOR_ARTIFACT_PATH",
          "format": "durable-runtime-selector-artifact-v1"
        }
      ],
      "exitCondition": "API, ingestion-worker, intelligence-worker, delivery-service and event-relay are proven on Postgres, RabbitMQ and real auth selectors."
    },
