{
  "schemaVersion": 1,
  "runnerId": "external-beta-evidence-runner-v1",
  "scope": "backend-only",
  "frontendPolicy": "deferred_contract_only",
  "defaultMode": "plan_only",
  "checkCommand": "npm run check:external-beta-evidence-runner",
  "planCommand": "npm run beta:evidence:plan",
  "jsonPlanCommand": "npm run --silent beta:evidence:plan:json",
  "summaryCommand": "npm run beta:evidence:summary",
  "handoffCommand": "npm run beta:evidence:handoff",
  "preflightCommand": "npm run beta:evidence:preflight",
  "artifactValidationCommand": "npm run beta:evidence:validate",
  "executeCommand": "npm run beta:evidence:run -- --execute",
  "runnerFile": "scripts/external-beta-evidence-runner.mjs",
  "checkFile": "scripts/check-external-beta-evidence-runner.mjs",
  "envExample": "ops/release/external-beta-evidence.env.example",
  "executionSafety": {
    "liveExecutionRequires": [
      "--execute",
      "EXTERNAL_BETA_EVIDENCE_CONFIRM=run-live"
    ],
    "forbiddenTargets": [
      "frontend",
      "mobile",
      "flutter",
      "agent-runtime",
      "claude-hooks"
    ],
    "defaultActionWithoutExecute": "print_plan_only",
    "manualArtifactJobsFailExecute": true,
    "artifactValidationSkipsLiveRunners": true,
    "secretValuesMustStayOutOfArtifacts": true,
    "criticalEnvValuesMustBeTyped": true,
    "evidencePathEnvRequiresAbsolutePath": true,
    "evidencePathEnvRequiresRegularFile": true,
    "evidencePathEnvMaxBytes": 26214400,
    "outputArtifactPathEnvRequiresJsonExtension": true
  },
  "artifactFreshness": {
    "maxArtifactAgeHours": 168,
    "maxArtifactFutureSkewMinutes": 10,
    "requiresIso8601Timestamp": true,
    "timestampPaths": [
      "sampledAt",
      "generatedAt",
      "completedAt",
      "environment.sampledAt",
      "source.sampleWindow.endedAt"
    ],
    "requiredTimestampFormats": [
      "durable-runtime-selector-artifact-v1",
      "source-live-provider-evidence-v1",
      "reddit-credential-lifecycle-redacted-v1",
      "source-credential-rotation-redacted-v1",
      "webhook-secret-rotation-redacted-v1",
      "staging-reliability-artifact-v1",
      "redacted-summary-feedback-samples-v1",
      "release-deploy-smoke-artifact-v1",
      "security-final-sweep-staging-artifact-v1"
    ]
  },
  "artifactExamples": [
    {
      "format": "durable-runtime-selector-artifact-v1",
      "path": "ops/release/fixtures/durable-runtime-selector-artifact-examples.json"
    },
    {
      "format": "source-live-provider-evidence-v1",
      "path": "ops/ingestion/fixtures/source-live-certification-artifact-examples.json"
    },
    {
      "format": "reddit-credential-lifecycle-redacted-v1",
      "path": "ops/ingestion/fixtures/reddit-credential-lifecycle-redacted.example.json"
    },
    {
      "format": "source-credential-rotation-redacted-v1",
      "path": "ops/security/fixtures/source-credential-rotation-redacted-examples.json"
    },
    {
      "format": "webhook-secret-rotation-redacted-v1",
      "path": "ops/security/fixtures/webhook-secret-rotation-redacted-examples.json"
    },
    {
      "format": "staging-reliability-artifact-v1",
      "path": "ops/drills/fixtures/staging-reliability-artifact-examples.json"
    },
    {
      "format": "redacted-summary-feedback-samples-v1",
      "path": "ops/release/fixtures/redacted-summary-feedback-samples-examples.json"
    },
    {
      "format": "release-deploy-smoke-artifact-v1",
      "path": "ops/release/fixtures/release-deploy-smoke-artifact-examples.json"
    },
    {
      "format": "security-final-sweep-staging-artifact-v1",
      "path": "ops/security/fixtures/security-final-sweep-staging-artifact-examples.json"
    }
  ],
  "jobs": [
    {
      "jobId": "release-baseline-freeze",
      "evidenceGroupId": "release-baseline-freeze",
      "requirementId": "release-baseline-freeze",
      "mode": "local_contract",
      "runPolicy": "local_contract",
      "owner": "release-owner",
      "blocksExternalBeta": true,
      "runnerCommand": null,
      "validationCommands": [
        "npm run check:release-baseline",
        "npm run check:backend-safe-verify",
        "npm run check:release-artifact-evidence"
      ],
      "requiredEnv": [],
      "optionalEnv": [],
      "outputArtifacts": [
        {
          "path": "ops/release/release-baseline-contract.json",
          "format": "release-baseline-contract-v1"
        }
      ],
      "exitCondition": "Backend-safe release baseline is green for the release commit."
    },
    {
      "jobId": "durable-runtime-staging-proof",
      "evidenceGroupId": "durable-runtime-proof",
      "requirementId": "durable-runtime-proof",
      "mode": "staging_artifact",
      "runPolicy": "manual_artifact_then_validator",
      "owner": "backend-lead",
      "blocksExternalBeta": true,
      "runnerCommand": null,
      "validationCommands": [
