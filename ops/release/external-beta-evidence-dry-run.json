{
  "schemaVersion": 1,
  "dryRunId": "external-beta-evidence-dry-run-v1",
  "scope": "backend-only",
  "frontendPolicy": "deferred_contract_only",
  "sourceRunnerContract": "ops/release/external-beta-evidence-runner.json",
  "sourceReadinessContract": "ops/release/external-beta-readiness-contract.json",
  "envExample": "ops/release/external-beta-evidence.env.example",
  "notEvidence": true,
  "doesNotUnblockExternalBeta": true,
  "defaultMode": "plan_only",
  "checkCommand": "npm run check:external-beta-evidence-dry-run",
