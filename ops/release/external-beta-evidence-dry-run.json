  "currentPackageCommand": "npm run beta:evidence:package-current",
  "liveExecutionTemplate": "EXTERNAL_BETA_EVIDENCE_CONFIRM=run-live npm run beta:evidence:run -- --execute",
  "safetyRequirements": [
    "dry-run must never execute live provider commands",
    "dry-run must never validate or write live evidence artifacts",
    "dry-run must keep frontend, mobile, flutter, agent-runtime and claude-hooks out of scope",
    "dry-run must keep every external beta blocker visible until staging/live evidence is attached",
    "dry-run must treat fixture and example artifacts as non-evidence",
    "dry-run must not print secret or credential values"
  ],
