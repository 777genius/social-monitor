{
  "schemaVersion": 1,
  "policyId": "beta-ring-expansion-policy-mvp-v1",
  "decisionModel": "go_hold_rework",
  "rings": [
    {
      "ringId": "internal-dogfood",
      "maxTenants": 1,
      "maxWorkspacesPerTenant": 1,
      "maxUsers": 3,
      "maxTopicsPerWorkspace": 5,
      "maxEnabledSourcesPerTopic": 5,
      "minScheduledScanIntervalMinutes": 60,
      "maxManualScansPerWorkspacePerHour": 20,
      "maxSummaryRequestsPerWorkspacePerHour": 10,
      "maxQueueLagSeconds": 300,
      "maxSummaryEstimatedCostUsdPerWorkspacePerDay": 5,
      "maxDeliveryAttemptsPerWorkspacePerHour": 50,
      "requiredGates": [
        "check:mvp-core-loop",
        "check:source-certification",
        "check:hn-smoke",
        "check:github-smoke",
        "check:github-repo-radar-smoke",
        "check:github-trending-page-smoke",
        "check:github-trending-page-html-e2e",
        "check:reddit-smoke",
        "check:rss-smoke",
        "check:beta-scope-policy",
        "check:delivery-replay"
      ]
    },
    {
      "ringId": "private-beta-1",
      "maxTenants": 3,
      "maxWorkspacesPerTenant": 2,
      "maxUsers": 5,
      "maxTopicsPerWorkspace": 10,
      "maxEnabledSourcesPerTopic": 5,
      "minScheduledScanIntervalMinutes": 60,
      "maxManualScansPerWorkspacePerHour": 50,
      "maxSummaryRequestsPerWorkspacePerHour": 20,
      "maxQueueLagSeconds": 300,
      "maxSummaryEstimatedCostUsdPerWorkspacePerDay": 5,
      "maxDeliveryAttemptsPerWorkspacePerHour": 100,
      "requiredGates": [
        "check:mvp-core-loop",
        "check:source-certification",
        "check:hn-smoke",
        "check:github-smoke",
        "check:github-repo-radar-smoke",
        "check:github-trending-page-smoke",
        "check:github-trending-page-html-e2e",
        "check:reddit-smoke",
        "check:rss-smoke",
        "check:beta-scope-policy",
        "check:load-cost",
        "check:observability",
        "check:summary-evals",
        "check:delivery-replay"
      ]
    },
    {
      "ringId": "private-beta-2",
      "maxTenants": 10,
      "maxWorkspacesPerTenant": 3,
      "maxUsers": 20,
      "maxTopicsPerWorkspace": 10,
      "maxEnabledSourcesPerTopic": 5,
      "minScheduledScanIntervalMinutes": 60,
      "maxManualScansPerWorkspacePerHour": 50,
      "maxSummaryRequestsPerWorkspacePerHour": 20,
      "maxQueueLagSeconds": 300,
      "maxSummaryEstimatedCostUsdPerWorkspacePerDay": 5,
      "maxDeliveryAttemptsPerWorkspacePerHour": 200,
      "requiredGates": [
        "check:mvp-core-loop",
        "check:source-certification",
        "check:hn-smoke",
        "check:github-smoke",
        "check:github-repo-radar-smoke",
        "check:github-trending-page-smoke",
        "check:github-trending-page-html-e2e",
        "check:reddit-smoke",
        "check:rss-smoke",
        "check:beta-scope-policy",
        "check:load-cost",
        "check:observability",
        "check:summary-evals",
        "check:summary-cost",
        "check:delivery-replay",
        "check:drills"
      ]
    }
  ],
  "capacityEvidence": {
    "loadCostGate": "npm run check:load-cost",
    "summaryCostArtifact": "ops/cost/summary-cost-attribution.json",
    "healthDashboard": "ops/observability/dashboards/mvp-health.json",
    "alerts": "ops/observability/alerts/mvp-alerts.json"
  },
  "sourceHealthThresholds": {
    "certificationGate": "npm run check:source-certification",
    "hackerNewsSmokeGate": "npm run check:hn-smoke",
    "githubIssuesSmokeGate": "npm run check:github-smoke",
    "githubRepoRadarSmokeGate": "npm run check:github-repo-radar-smoke",
    "githubTrendingPageSmokeGate": "npm run check:github-trending-page-smoke",
    "githubTrendingPageHtmlE2eGate": "npm run check:github-trending-page-html-e2e",
    "redditSmokeGate": "npm run check:reddit-smoke",
    "rssSmokeGate": "npm run check:rss-smoke",
    "scopePolicyGate": "npm run check:beta-scope-policy",
    "maxProviderFailureRatePercent": 5,
    "maxCursorResetRatePercent": 2,
    "unsupportedSourceBindingPolicy": "reject_binding_capture_source_request_feedback"
  },
  "costThresholds": {
    "maxSummaryEstimatedCostUsdPerWorkspacePerDay": 5,
    "maxManualScanRequestsPerWorkspacePerHour": 50,
    "defaultActionOnCostSpike": "hold_ring_expansion_reduce_frequency"
  },
  "degradationActions": [
    "hold_ring_expansion",
    "reduce_scan_frequency",
    "pause_affected_source_bindings",
    "lower_summary_budget",
    "keep_workers_paused_during_restore_or_replay_validation"
  ],
  "forbiddenFirstActions": [
    "expand_ring_without_gates",
    "enable_deferred_source_without_readiness",
    "add_workers_before_quota_or_source_pause_review",
    "replay_failed_jobs_before_restore_validation"
  ]
}
