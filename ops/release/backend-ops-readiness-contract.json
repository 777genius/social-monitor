{
  "schemaVersion": 1,
  "packageId": "backend-ops-readiness-beta-mvp-v1",
  "scope": "backend-only",
  "frontendPolicy": "deferred_contract_only",
  "realSocialCredentialsRequiredForThisGate": false,
  "liveSocialCredentialExitCriteria": [
    "source provider live beta evidence replaces fixture-only certification for each externally enabled provider",
    "tenant OAuth/API credentials are provided through approved secret storage and never through committed env files",
    "rate-limit, quota, rollback and source-health evidence is attached before expanding external beta"
  ],
  "releaseContract": "ops/release/mvp-release-evidence-contract.json",
  "sourceCertification": "ops/ingestion/source-provider-certification.json",
  "requiredDomains": [
    {
      "domainId": "auth-boundary",
      "gates": ["check:auth-boundary", "check:user-auth-boundary", "check:production-auth-matrix"],
      "releaseGateIds": ["auth-boundary", "user-auth-boundary", "production-auth-matrix"],
      "artifacts": [
        ".env.example",
        "docker-compose.yml",
        "test/e2e/user-jwt-auth-boundary.e2e-spec.ts",
        "test/e2e/production-auth-boundary-matrix.e2e-spec.ts",
        "ops/security/production-auth-matrix.json"
      ]
    },
    {
      "domainId": "credential-secret-runtime-flow",
      "gates": [
        "check:credential-secret-runtime-flow",
        "check:security-final-sweep",
        "check:secrets",
        "check:source-config-protector",
        "check:http-webhook-delivery-provider"
      ],
      "releaseGateIds": [
        "credential-secret-runtime-flow",
        "security-final-sweep",
        "secret-scan",
        "source-config-protector",
        "http-webhook-delivery-provider"
      ],
      "artifacts": [
        "ops/security/credential-secret-runtime-flow.json",
        "ops/security/security-final-sweep-evidence.json",
        "ops/security/secret-scan-allowlist.json",
        "scripts/check-credential-secret-runtime-flow.ts",
        "libs/shared-kernel/src/redaction.ts"
      ]
    },
    {
      "domainId": "durable-runtime",
      "gates": ["check:runtime-compose", "check:runtime-profile-guards", "check:container", "check:local-infra"],
      "releaseGateIds": ["runtime-compose-contract", "runtime-profile-guards", "container-contract", "local-infra-contract"],
      "artifacts": ["docker-compose.yml", "ops/release/persistence-readiness-contract.json"]
    },
    {
      "domainId": "postgres-reliability",
      "gates": [
        "check:migrations",
        "check:tenant-db-guards",
        "check:persistence-readiness",
        "check:event-store",
        "check:monitoring-persistence",
        "check:ingestion-feed-persistence",
        "check:summary-persistence",
        "check:identity-persistence",
        "check:usage-persistence",
        "check:delivery-persistence",
        "check:staging-reliability-evidence"
      ],
      "releaseGateIds": [
        "migration-safety",
        "tenant-db-guards",
        "persistence-readiness",
        "platform-event-store",
        "monitoring-prisma-persistence",
        "ingestion-feed-prisma-persistence",
        "summary-prisma-persistence",
        "identity-prisma-persistence",
        "usage-prisma-persistence",
        "delivery-prisma-persistence",
        "staging-reliability-evidence"
      ],
      "artifacts": [
        "prisma/schema.prisma",
        "ops/recovery/backup-restore-contract.json",
        "ops/privacy/retention-contract.json",
        "ops/drills/staging-reliability-evidence.json"
      ]
    },
    {
      "domainId": "rabbitmq-reliability",
      "gates": [
        "check:rabbitmq-queue-publisher",
        "check:scan-queue-drain-loop",
        "check:summary-queue-drain-loop",
        "check:delivery-attempt-queue-drain-loop",
        "check:event-relay",
        "check:staging-reliability-evidence"
      ],
      "releaseGateIds": [
        "rabbitmq-queue-publisher",
        "scan-queue-drain-loop",
        "summary-queue-drain-loop",
        "delivery-attempt-queue-drain-loop",
        "event-relay",
        "staging-reliability-evidence"
      ],
      "artifacts": ["docker-compose.yml", "ops/drills/staging-reliability-evidence.json"]
    },
    {
      "domainId": "observability-and-drills",
      "gates": [
        "check:observability",
        "check:backup-restore",
        "check:retention",
        "check:retention-plan",
        "check:drills",
        "check:staging-reliability-evidence"
      ],
      "releaseGateIds": [
        "observability-contract",
        "backup-restore-contract",
        "retention-contract",
        "retention-plan",
        "staging-drills",
        "staging-reliability-evidence"
      ],
      "artifacts": [
        "ops/observability/dashboards/mvp-health.json",
        "ops/observability/alerts/mvp-alerts.json",
        "ops/recovery/backup-restore-contract.json",
        "ops/privacy/retention-contract.json",
        "ops/drills/mvp-staging-drills.json",
        "ops/drills/staging-reliability-evidence.json"
      ]
    },
    {
      "domainId": "source-scope",
      "gates": [
        "check:source-certification",
        "check:source-live-certification-evidence",
        "check:beta-scope-policy",
        "check:beta-ring-policy"
      ],
      "releaseGateIds": [
        "source-provider-certification",
        "source-live-certification-evidence",
        "beta-scope-policy",
        "beta-ring-policy"
      ],
      "artifacts": [
        "ops/ingestion/source-provider-certification.json",
        "ops/ingestion/source-live-certification-evidence.json",
        "ops/release/beta-ring-expansion-policy.json",
        "ops/release/beta-ring-expansion-decision-record.json"
      ]
    },
    {
      "domainId": "mvp-loop",
      "gates": [
        "check:mvp-core-loop",
        "check:openapi",
        "check:events",
        "check:usage-audit-rest",
        "check:staging-reliability-evidence",
        "check:summary-feedback-hardening"
      ],
      "releaseGateIds": [
        "mvp-core-loop",
        "openapi-drift",
        "event-contracts",
        "usage-audit-rest",
        "staging-reliability-evidence",
        "summary-feedback-hardening"
      ],
      "artifacts": [
        "libs/contracts/rest/openapi.snapshot.json",
        "libs/contracts/events/event-catalog.json",
        "ops/drills/staging-reliability-evidence.json",
        "ops/release/summary-feedback-hardening-evidence.json"
      ]
    },
    {
      "domainId": "external-beta-evidence",
      "gates": [
        "check:release-baseline",
        "check:backend-safe-verify",
        "check:durable-runtime-proof",
        "check:external-beta-readiness",
        "check:no-go-cleanup",
        "check:release-artifact-evidence"
      ],
      "releaseGateIds": [
        "release-baseline",
        "backend-safe-verify-contract",
        "durable-runtime-proof",
        "external-beta-readiness",
        "no-go-cleanup",
        "release-artifact-evidence"
      ],
      "artifacts": [
        "ops/release/release-baseline-contract.json",
        "ops/release/backend-safe-verify-contract.json",
        "ops/release/durable-runtime-proof.json",
        "ops/release/external-beta-readiness-contract.json",
        "ops/release/no-go-cleanup-contract.json",
        "ops/release/release-artifact-evidence.json"
      ]
    }
  ],
  "requiredRuntimeMarkers": [
    {
      "file": "docker-compose.yml",
      "marker": "SOCIAL_MONITOR_RUNTIME_PROFILE: beta"
    },
    {
      "file": "docker-compose.yml",
      "marker": "SOCIAL_MONITOR_USER_AUTH_MODE: ${SOCIAL_MONITOR_USER_AUTH_MODE:-oidc-jwt}"
    },
    {
      "file": "docker-compose.yml",
      "marker": "MONITORING_SCAN_QUEUE: rabbitmq"
    },
    {
      "file": "docker-compose.yml",
      "marker": "SUMMARY_JOB_QUEUE_MODE: rabbitmq"
    },
    {
      "file": "docker-compose.yml",
      "marker": "DELIVERY_ATTEMPT_QUEUE_READER: rabbitmq"
    },
    {
      "file": "docker-compose.yml",
      "marker": "EVENT_RELAY_LOOP: enabled"
    },
    {
      "file": "docker-compose.yml",
      "marker": "RABBITMQ_DEAD_LETTER_EXCHANGE: social-monitor.commands.dlx"
    },
    {
      "file": "docker-compose.yml",
      "marker": "RABBITMQ_QUEUE_TYPE: quorum"
    },
    {
      "file": "docker-compose.yml",
      "marker": "RABBITMQ_QUEUE_DELIVERY_LIMIT: \"20\""
    }
  ],
  "runbook": "docs/iterations/06-production-hardening/12-operational-runbook.md#release-rollback-triage",
  "promotionDoc": "docs/iterations/06-production-hardening/42-release-gate-and-promotion.md"
}
