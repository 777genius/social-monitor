# External beta evidence environment example.
# Keep values empty in git. Fill them only in the operator shell or approved secret store.
# All *_PATH evidence files must be absolute JSON paths outside the workspace with 0600-style private permissions.

# Runner confirmation. Leave empty unless intentionally running live evidence commands.
EXTERNAL_BETA_EVIDENCE_CONFIRM=

# Required external beta evidence env.
API_BASE_URL=
BACKEND_IMAGE_DIGEST=
BACKEND_GIT_COMMIT_SHA=
