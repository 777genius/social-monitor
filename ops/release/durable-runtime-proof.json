{
  "schemaVersion": 1,
  "proofId": "durable-runtime-proof-beta-compose-v1",
  "scope": "backend-only",
  "proofMode": "compose_contract_without_live_deploy",
  "externalBetaStatus": "hold_until_staging_runtime_evidence",
  "composeFile": "docker-compose.yml",
  "stagingRuntimeEvidence": {
    "status": "pending_staging_evidence",
    "requiredForExternalBeta": true,
    "owner": "backend-lead",
    "artifactPath": null,
    "environmentId": null,
    "imageDigest": null,
    "apiBaseUrl": null,
    "sampledAt": null,
    "exitCondition": "Attach staging runtime selector evidence proving API and workers use Postgres, RabbitMQ and OIDC/JWT selectors."
  },
  "stagingRuntimeEvidenceSchema": {
    "artifactFormat": "durable-runtime-selector-artifact-v1",
    "exampleArtifact": "ops/release/fixtures/durable-runtime-selector-artifact-examples.json",
    "requiredServices": [
      "api-gateway",
      "ingestion-worker",
      "intelligence-worker",
      "delivery-service",
      "event-relay"
    ],
    "requiredSharedSelectors": {
      "SOCIAL_MONITOR_RUNTIME_PROFILE": "beta",
      "DATABASE_URL_KIND": "postgresql",
      "RABBITMQ_URL_KIND": "amqp",
      "SOCIAL_MONITOR_USER_AUTH_MODE": "oidc-jwt"
    },
    "forbiddenSelectorValues": [
      "in-memory",
      "noop",
      "auth-disabled",
      "event-relay-disabled"
    ],
    "requiredRuntimeEnv": [
      "STAGING_ENVIRONMENT_ID",
      "BACKEND_IMAGE_DIGEST",
      "API_BASE_URL",
      "DURABLE_RUNTIME_SELECTOR_ARTIFACT_PATH"
    ],
    "exitCondition": "DURABLE_RUNTIME_SELECTOR_ARTIFACT_PATH must validate against durable-runtime-selector-artifact-v1 before external beta go."
  },
  "requiredComposeMarkers": [
    "SOCIAL_MONITOR_RUNTIME_PROFILE: beta",
    "DATABASE_URL: postgresql://social_monitor:social_monitor_local_password@postgres:5432/social_monitor",
    "RABBITMQ_URL: amqp://social_monitor:social_monitor_local_password@rabbitmq:5672",
    "SOCIAL_MONITOR_USER_AUTH_MODE: ${SOCIAL_MONITOR_USER_AUTH_MODE:-oidc-jwt}",
    "MONITORING_PERSISTENCE: prisma",
    "MONITORING_SCAN_QUEUE: rabbitmq",
    "FEED_PERSISTENCE: prisma",
    "SUMMARY_PERSISTENCE: prisma",
    "SUMMARY_JOB_QUEUE_MODE: rabbitmq",
    "DELIVERY_PERSISTENCE: prisma",
    "DELIVERY_WEBHOOK_PROVIDER: http",
    "IDENTITY_PERSISTENCE: prisma",
    "USAGE_PERSISTENCE: prisma",
    "INGESTION_SUPPORT_PERSISTENCE: prisma",
    "INGESTION_WORKER_PERSISTENCE: prisma",
    "INGESTION_SCAN_QUEUE_READER: rabbitmq",
    "INGESTION_SCAN_QUEUE_DRAIN_LOOP: enabled",
    "INGESTION_SCAN_REPORTER: monitoring",
    "INTELLIGENCE_SUMMARY_QUEUE_READER: rabbitmq",
    "INTELLIGENCE_SUMMARY_QUEUE_DRAIN_LOOP: enabled",
    "INTELLIGENCE_SUMMARY_JOB_LOOP: disabled",
    "DELIVERY_ATTEMPT_DISPATCH_TARGET: queue",
    "DELIVERY_ATTEMPT_DISPATCH_QUEUE: rabbitmq",
    "DELIVERY_ATTEMPT_QUEUE_READER: rabbitmq",
    "DELIVERY_ATTEMPT_QUEUE_DRAIN_LOOP: enabled",
    "EVENT_RELAY_LOOP: enabled",
    "RABBITMQ_QUEUE_TYPE: quorum",
    "RABBITMQ_QUEUE_DELIVERY_LIMIT: \"20\""
  ],
  "forbiddenBetaSelectorValues": [
    "MONITORING_PERSISTENCE: in-memory",
    "MONITORING_SCAN_QUEUE: in-memory",
    "FEED_PERSISTENCE: in-memory",
    "SUMMARY_PERSISTENCE: in-memory",
    "SUMMARY_JOB_QUEUE_MODE: in-memory",
    "DELIVERY_PERSISTENCE: in-memory",
    "IDENTITY_PERSISTENCE: in-memory",
    "USAGE_PERSISTENCE: in-memory",
    "INGESTION_SUPPORT_PERSISTENCE: in-memory",
    "INGESTION_WORKER_PERSISTENCE: in-memory",
    "INGESTION_SCAN_QUEUE_READER: in-memory",
    "INTELLIGENCE_SUMMARY_QUEUE_READER: in-memory",
    "DELIVERY_ATTEMPT_QUEUE_READER: in-memory",
    "EVENT_RELAY_LOOP: disabled",
    "SOCIAL_MONITOR_USER_AUTH_MODE: disabled"
  ],
  "stagingExitCriteria": [
    "DURABLE_RUNTIME_SELECTOR_ARTIFACT_PATH validates against durable-runtime-selector-artifact-v1",
    "deploy the same image digest with the durable selector set",
    "run backend beta loop against shared Postgres and RabbitMQ",
    "prove worker restart keeps scan/feed/summary/delivery state visible",
    "attach deploy smoke output to release artifact evidence"
  ]
}
