{
  "schemaVersion": 1,
  "contractId": "summary-memory-runtime-canary-v1",
  "externalBetaStatus": "hold_until_runtime_canary_evidence",
  "scope": "backend-summary-memory",
  "runnerCommand": "npm run check:summary-memory-runtime-canary",
  "runnerFile": "scripts/check-summary-memory-runtime-canary.ts",
  "checkCommand": "npm run check:summary-memory-runtime-canary-evidence",
  "checkFile": "scripts/check-summary-memory-runtime-canary-evidence.mjs",
  "artifactEnv": "SUMMARY_MEMORY_RUNTIME_CANARY_EVIDENCE_PATH",
