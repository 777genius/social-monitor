{
  "schemaVersion": 1,
  "contractId": "production-secret-boundary-v1",
  "scope": "backend-only",
  "frontendPolicy": "deferred_contract_only",
  "checkCommand": "npm run check:production-secret-boundary",
  "releaseGateId": "production-secret-boundary",
  "allowedLocalOnlyEnvFiles": [
    ".env.example",
    "docker-compose.yml"
  ],
  "operatorEvidenceEnvExample": "ops/release/external-beta-evidence.env.example",
  "productionProfiles": [
    "beta",
    "staging",
    "production"
  ],
  "secretReferences": [
    {
      "secretClass": "postgres-credentials",
      "rawEnv": "DATABASE_URL",
      "secretRefEnv": "DATABASE_URL_SECRET_REF",
      "requiredForProfiles": ["beta", "staging", "production"],
      "committedPlaintextAllowed": false
    },
    {
      "secretClass": "rabbitmq-credentials",
      "rawEnv": "RABBITMQ_URL",
      "secretRefEnv": "RABBITMQ_URL_SECRET_REF",
      "requiredForProfiles": ["beta", "staging", "production"],
      "committedPlaintextAllowed": false
    },
    {
      "secretClass": "oidc-config",
      "rawEnv": "SOCIAL_MONITOR_OIDC_JWKS_JSON",
      "secretRefEnv": "OIDC_CONFIG_SECRET_REF",
      "requiredForProfiles": ["beta", "staging", "production"],
      "committedPlaintextAllowed": false,
      "operatorEvidenceRawEnvRequired": false
    },
    {
      "secretClass": "oidc-test-token",
      "rawEnv": "OIDC_TEST_TOKEN_REF",
      "secretRefEnv": "OIDC_TEST_TOKEN_REF",
      "requiredForProfiles": ["staging"],
      "committedPlaintextAllowed": false
    }
  ],
  "deployMetadata": [
    {
      "env": "DEPLOYMENT_ID",
      "requiredForProfiles": ["staging", "production"],
      "committedPlaintextAllowed": false
    },
    {
      "env": "BACKEND_IMAGE_DIGEST",
      "requiredForProfiles": ["beta", "staging", "production"],
      "committedPlaintextAllowed": false
    },
    {
      "env": "BACKEND_GIT_COMMIT_SHA",
      "requiredForProfiles": ["beta", "staging", "production"],
      "committedPlaintextAllowed": false
    },
    {
      "env": "RELEASE_DEPLOY_SMOKE_ARTIFACT_PATH",
      "requiredForProfiles": ["beta", "staging", "production"],
      "committedPlaintextAllowed": false
    },
    {
      "env": "BACKUP_OBJECT_URI",
      "requiredForProfiles": ["staging", "production"],
      "committedPlaintextAllowed": false
    }
  ],
  "publicAuthMetadata": [
    "OIDC_ISSUER",
    "JWKS_URL"
  ],
  "forbiddenCommittedValuePatterns": [
    "postgresql://",
    "postgres://",
    "amqp://",
    "amqps://",
    "Bearer ",
    "github_pat_",
    "xoxb-",
    "reddit-refresh-token",
    "reddit-live-access-value"
  ],
  "exitCriteria": [
    "Docker/local evidence may use disposable local DATABASE_URL and RABBITMQ_URL only in local-only files.",
    "Beta, staging and production promotions must provide DATABASE_URL, RABBITMQ_URL and OIDC config through secret refs or approved runtime mounts.",
    "Release deploy metadata must include deployment id, immutable image digest, commit SHA and deploy smoke artifact path outside the git workspace.",
    "Operator evidence examples keep values empty in git and never contain raw tokens, credential URLs or private JWKS payloads."
  ]
}
