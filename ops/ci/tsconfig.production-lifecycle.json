{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "types": [
      "node"
    ],
    "skipLibCheck": false
  },
  "include": [
    "production-lifecycle-runner.mts",
    "production-lifecycle-keeper.mts",
    "production-lifecycle-runner.test.mts"
  ]
}
