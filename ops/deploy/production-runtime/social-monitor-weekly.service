[Unit]
Description=Social Monitor weekly AI reader summary
After=social-monitor-prod.service network-online.target
Requires=social-monitor-prod.service
StartLimitIntervalSec=3h
StartLimitBurst=3

[Service]
Type=oneshot
ExecStart=/bin/bash -lc 'set -euo pipefail; ROOT=/var/data/social-monitor; release=$(cat "$ROOT/control/deploy-state/backend.sha"); [[ $release =~ ^[0-9a-f]{40}$ ]] || exit 75; exec "$ROOT/control/github-production-deploy.sh" reader-summary-weekly-run "$release"'
TimeoutStartSec=3600
Restart=on-failure
RestartSec=30min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
