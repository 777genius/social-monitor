{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "enum": [
        2,
        3
      ]
    },
    "labelSealSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "replaySha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "captureSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ownedFiles": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "effectBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runTaskCalls": {
          "type": "integer",
          "minimum": 0
        },
        "maxOutputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "timeoutMsPerCall": {
          "const": 300000
        }
      },
      "required": [
        "runTaskCalls",
        "maxOutputTokens",
        "timeoutMsPerCall"
      ]
    },
    "requests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "blockId": {
            "type": "string"
          },
          "command": {
            "type": "object"
          },
          "commandSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "canonicalRequest": {
            "type": "object"
          },
          "canonicalRequestSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "schemaSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "candidateCount": {
            "type": "integer",
            "minimum": 1
          },
          "evidenceSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "blockId",
          "command",
          "commandSha256",
          "canonicalRequest",
          "canonicalRequestSha256",
          "schemaSha256",
          "candidateCount",
          "evidenceSha256"
        ]
      }
    },
    "liveStatus": {
      "const": "NOT_RUN"
    },
    "captureSourceRevision": {
      "const": "e83b577f85d3f287055dc0a6154bef6a35b50bd2"
    },
    "evaluatedSource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "treeSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "worktree": {
          "const": "clean"
        }
      },
      "required": [
        "revision",
        "treeSha",
        "worktree"
      ]
    },
    "evaluationRun": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "namespaceSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "id",
        "namespaceSha256"
      ]
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profileId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "modelBackend": {
          "enum": [
            "openai-chatgpt",
            "kimi-code",
            "openrouter"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "reasoningEffort": {
          "enum": [
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max",
            "ultra"
          ]
        },
        "minOutputTokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        }
      },
      "required": [
        "profileId",
        "modelBackend",
        "model",
        "minOutputTokens"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "labelSealSha256",
    "replaySha256",
    "captureSha256",
    "ownedFiles",
    "effectBudget",
    "requests",
    "liveStatus",
    "captureSourceRevision",
    "evaluatedSource"
  ],
  "$schema": "http://json-schema.org/draft-07/schema#",
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 3
          }
        }
      },
      "then": {
        "required": [
          "gateway"
        ]
      },
      "else": {
        "not": {
          "required": [
            "gateway"
          ]
        }
      }
    }
  ]
}
