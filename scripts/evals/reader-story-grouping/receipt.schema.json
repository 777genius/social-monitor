{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "enum": [
        2,
        3
      ]
    },
    "captureKind": {
      "enum": [
        "live_subscription",
        "offline_fixture",
        "live_gateway"
      ]
    },
    "manifestSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "labelSealSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "replaySha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authentication": {
          "enum": [
            "existing_authenticated_composition",
            "deterministic_fixture"
          ]
        },
        "operatorRecord": {
          "type": "string",
          "minLength": 1
        },
        "runtimePackageVersion": {
          "type": "string"
        },
        "launcherSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "runtimeEngine": {
          "const": "gateway-llm"
        }
      },
      "required": [
        "authentication",
        "operatorRecord",
        "runtimePackageVersion",
        "launcherSha256"
      ]
    },
    "responses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "blockId": {
            "type": "string"
          },
          "commandSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "canonicalRequestSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "schemaSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "evidenceSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "receivedAt": {
            "type": "string",
            "format": "date-time"
          },
          "result": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "status": {
                "const": "completed"
              },
              "structuredOutput": {
                "type": "object"
              },
              "outputText": {
                "type": "string"
              },
              "warnings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "code",
                    "message"
                  ]
                }
              },
              "usage": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "inputTokens": {
                    "type": "number",
                    "minimum": 0
                  },
                  "outputTokens": {
                    "type": "number",
                    "minimum": 0
                  },
                  "totalTokens": {
                    "type": "number",
                    "minimum": 0
                  },
                  "estimatedCostUsd": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "inputTokens",
                  "outputTokens",
                  "totalTokens",
                  "estimatedCostUsd"
                ]
              },
              "durationMs": {
                "type": "number",
                "minimum": 0
              },
              "executionAttestation": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "schemaVersion": {
                    "const": 1
                  },
                  "requestId": {
                    "type": "string"
                  },
                  "purpose": {
                    "type": "string"
                  },
                  "canonicalRequestSha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "provider": {
                    "const": "codex"
                  },
                  "model": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reasoningEffort": {
                    "enum": [
                      "default",
                      "minimal",
                      "low",
                      "medium",
                      "high",
                      "xhigh",
                      "max",
                      "ultra"
                    ]
                  },
                  "runtimeEngine": {
                    "enum": [
                      "subscription-runtime-cli",
                      "gateway-llm"
                    ]
                  },
                  "runtimePackageVersion": {
                    "type": "string"
                  },
                  "launcherSha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "selectedOutputKind": {
                    "const": "structured_output"
                  },
                  "selectedOutputSha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "gateway": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "profileId": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
                      },
                      "taskId": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
                      },
                      "requestRef": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
                      },
                      "executionRef": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
                      },
                      "accountRef": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
                      },
                      "attempt": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "observedModel": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "requestSha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      }
                    },
                    "required": [
                      "profileId",
                      "taskId",
                      "requestRef",
                      "executionRef",
                      "accountRef",
                      "attempt",
                      "observedModel",
                      "requestSha256"
                    ]
                  }
                },
                "required": [
                  "schemaVersion",
                  "requestId",
                  "purpose",
                  "canonicalRequestSha256",
                  "provider",
                  "model",
                  "reasoningEffort",
                  "runtimeEngine",
                  "runtimePackageVersion",
                  "launcherSha256",
                  "selectedOutputKind",
                  "selectedOutputSha256"
                ],
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "runtimeEngine": {
                          "const": "gateway-llm"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "gateway"
                      ]
                    },
                    "else": {
                      "not": {
                        "required": [
                          "gateway"
                        ]
                      }
                    }
                  }
                ]
              }
            },
            "required": [
              "status",
              "structuredOutput",
              "warnings",
              "executionAttestation"
            ]
          }
        },
        "required": [
          "blockId",
          "commandSha256",
          "canonicalRequestSha256",
          "schemaSha256",
          "evidenceSha256",
          "receivedAt",
          "result"
        ]
      }
    },
    "captureSourceRevision": {
      "const": "e83b577f85d3f287055dc0a6154bef6a35b50bd2"
    },
    "evaluatedSource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "treeSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "worktree": {
          "const": "clean"
        }
      },
      "required": [
        "revision",
        "treeSha",
        "worktree"
      ]
    },
    "evaluationRun": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "namespaceSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "id",
        "namespaceSha256"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "captureKind",
    "manifestSha256",
    "labelSealSha256",
    "replaySha256",
    "transport",
    "responses",
    "captureSourceRevision",
    "evaluatedSource"
  ],
  "$schema": "http://json-schema.org/draft-07/schema#"
}
