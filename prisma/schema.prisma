  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, workspaceId, subjectKey, operation, windowStartedAt])
  @@index([windowEndsAt])
  @@map("usage_quota_buckets")
}

model OutboxEvent {
  id                       String                    @id @db.Uuid
  tenantId                 String?                   @map("tenant_id") @db.Uuid
  workspaceId              String?                   @map("workspace_id") @db.Uuid
  messageKind              OutboxMessageKind         @default(EVENT) @map("message_kind")
  eventType                String                    @map("event_type")
  schemaVersion            Int                       @map("schema_version")
  payload                  Json
  status                   OutboxStatus              @default(PENDING)
  correlationId            String                    @map("correlation_id")
  causationId              String?                   @map("causation_id")
  availableAt              DateTime                  @default(now()) @map("available_at") @db.Timestamptz(6)
  publishAttempts          Int                       @default(0) @map("publish_attempts")
  leaseOwner               String?                   @map("lease_owner")
  leasedUntil              DateTime?                 @map("leased_until") @db.Timestamptz(6)
  lastError                String?                   @map("last_error")
  createdAt                DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt              DateTime?                 @map("published_at") @db.Timestamptz(6)
  readerSummaryPublication ReaderSummaryPublication?

  @@index([tenantId, workspaceId, status, createdAt])
  @@index([messageKind, status, availableAt, createdAt], map: "outbox_events_dispatch_idx")
  @@map("outbox_events")
}

model InboxRecord {
  id            String   @id @db.Uuid
  consumerName  String   @map("consumer_name")
  eventId       String   @map("event_id") @db.Uuid
  tenantId      String?  @map("tenant_id") @db.Uuid
  processedAt   DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)
  schemaVersion Int      @map("schema_version")

  @@unique([consumerName, eventId])
  @@index([tenantId, processedAt])
  @@map("inbox_records")
}

model IdempotencyKey {
  id              String    @id @db.Uuid
  tenantId        String?   @map("tenant_id") @db.Uuid
  workspaceId     String?   @map("workspace_id") @db.Uuid
  scope           String
  key             String
  requestHash     String?   @map("request_hash")
  responseStatus  Int?      @map("response_status")
  responsePayload Json?     @map("response_payload")
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([tenantId, workspaceId, scope, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

model SocialResearchResultCacheEntry {
  tenantId    String   @map("tenant_id") @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  kind        String
  cacheKey    String   @map("cache_key")
  payload     Json
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([tenantId, workspaceId, kind, cacheKey])
  @@index([tenantId, workspaceId, kind, updatedAt])
  @@index([expiresAt])
  @@map("social_research_result_cache_entries")
}
