generator client {
  provider     = "prisma-client"
  output       = "../prisma/generated/client"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum InterestStatus {
  ENABLED
  DISABLED
  ARCHIVED
}

enum SourceBindingStatus {
  DRAFT
  ENABLED
  PAUSED
  FAILED
}

enum SourceCredentialKind {
  OAUTH2
  API_TOKEN
  BEARER_TOKEN
  APP_OAUTH
}

enum SourceCredentialStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum ScanJobStatus {
  REQUESTED
  ENQUEUED
  SUCCEEDED
  FAILED
  CANCELLED
}

enum FeedItemStatus {
  VISIBLE
  HIDDEN
  TOMBSTONED
}

enum SummaryStatus {
  REQUESTED
  RUNNING
  COMPLETED
  NO_SIGNAL
  FAILED
  REJECTED
  SUPERSEDED
}

enum DeliveryStatus {
  QUEUED
  ASSEMBLING
  SUPPRESSED
  SENDING
  DELIVERED
  FAILED_RETRYABLE
  FAILED_TERMINAL
  DEAD_LETTERED
  CANCELLED
}

enum DeliveryDigestStatus {
  ASSEMBLED
  EMPTY
}

enum DigestScheduleStatus {
  ENABLED
  DISABLED
}

enum UserSubscriptionStatus {
  ENABLED
  PAUSED
  CANCELLED
}

enum UserSubscriptionScheduleStatus {
  ENABLED
  DISABLED
}

enum WebhookEndpointStatus {
  ENABLED
  DISABLED
  QUARANTINED
}

enum UsageKind {
  SCAN
  AI_SUMMARY
  DELIVERY
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

enum OutboxMessageKind {
  EVENT
  COMMAND
}

enum ScanFailureQueueStatus {
  RETRY_ENQUEUED
  DEAD_LETTERED
}

enum ScanAttemptStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum EngagementObservationReason {
  INITIAL
  CADENCE
  FINAL
  LEGACY_BACKFILL
}

enum ApiKeyCredentialStatus {
  ACTIVE
  REVOKED
}

model Tenant {
  id         String      @id @db.Uuid
  slug       String      @unique
  name       String
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime?   @map("deleted_at") @db.Timestamptz(6)
  workspaces Workspace[]
  users      User[]

  @@map("tenants")
}

model Workspace {
  id          String       @id @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  slug        String
  name        String
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?    @map("deleted_at") @db.Timestamptz(6)
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  memberships Membership[]
  interests   Interest[]

  @@unique([tenantId, slug])
  @@index([tenantId, createdAt])
  @@map("workspaces")
}

model User {
  id          String       @id @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  email       String
  displayName String       @map("display_name")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?    @map("deleted_at") @db.Timestamptz(6)
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  memberships Membership[]

  @@unique([tenantId, email])
  @@index([tenantId, createdAt])
  @@map("users")
}

model Membership {
  id          String         @id @db.Uuid
  tenantId    String         @map("tenant_id") @db.Uuid
  workspaceId String         @map("workspace_id") @db.Uuid
  userId      String         @map("user_id") @db.Uuid
  role        MembershipRole
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  user        User           @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([tenantId, workspaceId, userId])
  @@index([tenantId, userId])
  @@map("memberships")
}

model ApiKeyCredential {
  id          String                 @id @db.Uuid
  tenantId    String                 @map("tenant_id") @db.Uuid
  workspaceId String                 @map("workspace_id") @db.Uuid
  name        String
  keyPrefix   String                 @unique @map("key_prefix")
  secretHash  String                 @map("secret_hash")
  scopes      String[]
  status      ApiKeyCredentialStatus @default(ACTIVE)
  createdAt   DateTime               @map("created_at") @db.Timestamptz(6)
  revokedAt   DateTime?              @map("revoked_at") @db.Timestamptz(6)
  updatedAt   DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, workspaceId, createdAt])
  @@index([tenantId, workspaceId, status])
  @@map("api_keys")
}

model Interest {
  id          String         @id @db.Uuid
  tenantId    String         @map("tenant_id") @db.Uuid
  workspaceId String         @map("workspace_id") @db.Uuid
  name        String
  query       String
  status      InterestStatus @default(ENABLED)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?      @map("deleted_at") @db.Timestamptz(6)
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@unique([tenantId, workspaceId, name], map: "interests_tenant_id_workspace_id_name_key")
  @@index([tenantId, workspaceId, status, createdAt], map: "interests_tenant_id_workspace_id_status_created_at_idx")
  @@map("interests")
}

model SourceCatalogEntry {
  id                 String              @id @db.Uuid
  providerKey        String              @unique @map("provider_key")
  displayName        String              @map("display_name")
  acquisitionMode    String              @map("acquisition_mode")
  readiness          String
  capabilityProfiles CapabilityProfile[]
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("source_catalog_entries")
}

model CapabilityProfile {
  id            String             @id @db.Uuid
  sourceId      String             @map("source_id") @db.Uuid
  version       Int
  schemaVersion Int                @default(1) @map("schema_version")
  config        Json
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  source        SourceCatalogEntry @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([sourceId, version])
  @@map("capability_profiles")
}

model SourceBinding {
  id                       String              @id @db.Uuid
  tenantId                 String              @map("tenant_id") @db.Uuid
  workspaceId              String              @map("workspace_id") @db.Uuid
  interestId               String              @map("interest_id") @db.Uuid
  sourceCatalogEntryId     String              @map("source_catalog_entry_id") @db.Uuid
  capabilityProfileVersion Int                 @map("capability_profile_version")
  status                   SourceBindingStatus @default(DRAFT)
  config                   Json
  cursorResetRequestedAt   DateTime?           @map("cursor_reset_requested_at") @db.Timestamptz(6)
  createdAt                DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                DateTime?           @map("deleted_at") @db.Timestamptz(6)

  @@index([tenantId, workspaceId, interestId, status], map: "source_bindings_tenant_workspace_interest_status_idx")
  @@map("source_bindings")
}

model SourceCredential {
  id            String                 @id @db.Uuid
  tenantId      String                 @map("tenant_id") @db.Uuid
  workspaceId   String                 @map("workspace_id") @db.Uuid
  providerKey   String                 @map("provider_key")
  kind          SourceCredentialKind
  status        SourceCredentialStatus @default(ACTIVE)
  secretKeyId   String                 @unique @map("secret_key_id")
  secretPreview String                 @map("secret_preview")
  scopes        String[]
  expiresAt     DateTime?              @map("expires_at") @db.Timestamptz(6)
  rotatedAt     DateTime?              @map("rotated_at") @db.Timestamptz(6)
  revokedAt     DateTime?              @map("revoked_at") @db.Timestamptz(6)
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, workspaceId, providerKey, status])
  @@index([tenantId, workspaceId, updatedAt])
  @@map("source_credentials")
}

model SourceCredentialSecret {
  id         String   @id
  algorithm  String
  ciphertext String
  iv         String
  authTag    String   @map("auth_tag")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("source_credential_secrets")
}

model ScanPolicy {
  id               String   @id @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  workspaceId      String   @map("workspace_id") @db.Uuid
  sourceBindingId  String   @map("source_binding_id") @db.Uuid
  intervalSeconds  Int      @map("interval_seconds")
  freshnessSeconds Int      @map("freshness_seconds")
  retryBudget      Int      @map("retry_budget")
  nextRunAt        DateTime @map("next_run_at") @db.Timestamptz(6)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, sourceBindingId])
  @@index([tenantId, workspaceId])
  @@map("scan_policies")
}

model ScanJob {
  id                String        @id @db.Uuid
  tenantId          String        @map("tenant_id") @db.Uuid
  workspaceId       String        @map("workspace_id") @db.Uuid
  sourceBindingId   String        @map("source_binding_id") @db.Uuid
  scanPolicyId      String        @map("scan_policy_id") @db.Uuid
  status            ScanJobStatus @default(REQUESTED)
  idempotencyKey    String        @map("idempotency_key")
  leasedUntil       DateTime?     @map("leased_until") @db.Timestamptz(6)
  retryCount        Int           @default(0) @map("retry_count")
  failureClass      String?       @map("failure_class")
  requestedAt       DateTime      @map("requested_at") @db.Timestamptz(6)
  enqueuedAt        DateTime?     @map("enqueued_at") @db.Timestamptz(6)
  completedAt       DateTime?     @map("completed_at") @db.Timestamptz(6)
  failureReason     String?       @map("failure_reason")
  failureMetadata   Json?         @map("failure_metadata")
  executionMetadata Json?         @map("execution_metadata")
  correlationId     String?       @map("correlation_id")
  causationId       String?       @map("causation_id")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, workspaceId, status, createdAt])
  @@map("scan_jobs")
}

model ScanSchedulerDecision {
  id                              String    @id @db.Uuid
  tenantId                        String    @map("tenant_id") @db.Uuid
  workspaceId                     String    @map("workspace_id") @db.Uuid
  decisionKey                     String    @map("decision_key")
  scanPolicyId                    String    @map("scan_policy_id") @db.Uuid
  sourceBindingId                 String    @map("source_binding_id") @db.Uuid
  providerKey                     String?   @map("provider_key")
  decision                        String
  reason                          String
  scanJobId                       String?   @map("scan_job_id") @db.Uuid
  policyDueAt                     DateTime  @map("policy_due_at") @db.Timestamptz(6)
  evaluatedAt                     DateTime  @map("evaluated_at") @db.Timestamptz(6)
  nextRunAt                       DateTime  @map("next_run_at") @db.Timestamptz(6)
  configuredIntervalSeconds       Int       @map("configured_interval_seconds")
  effectiveIntervalSeconds        Int?      @map("effective_interval_seconds")
  freshnessSeconds                Int?      @map("freshness_seconds")
  providerMinimumIntervalEnforced Boolean?  @map("provider_minimum_interval_enforced")
  backoffUntil                    DateTime? @map("backoff_until") @db.Timestamptz(6)
  correlationId                   String?   @map("correlation_id")
  causationId                     String?   @map("causation_id")
  createdAt                       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, workspaceId, decisionKey])
  @@index([tenantId, workspaceId, sourceBindingId, evaluatedAt])
  @@index([tenantId, workspaceId, providerKey, evaluatedAt])
  @@index([tenantId, workspaceId, decision, reason, evaluatedAt])
  @@map("scan_scheduler_decisions")
}

model CursorCheckpoint {
  id              String   @id @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  sourceBindingId String   @map("source_binding_id") @db.Uuid
  schemaVersion   Int      @default(1) @map("schema_version")
  cursorPayload   Json     @map("cursor_payload")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, sourceBindingId])
  @@index([tenantId, workspaceId])
  @@map("cursor_checkpoints")
}

model SourceItem {
  id                     String                            @id @db.Uuid
  tenantId               String                            @map("tenant_id") @db.Uuid
  workspaceId            String                            @map("workspace_id") @db.Uuid
  sourceBindingId        String                            @map("source_binding_id") @db.Uuid
  providerKey            String                            @map("provider_key")
  providerItemId         String                            @map("provider_item_id")
  canonicalUrl           String                            @map("canonical_url")
  title                  String
  body                   String
  authorHandle           String?                           @map("author_handle")
  publishedAt            DateTime                          @map("published_at") @db.Timestamptz(6)
  contentHash            String                            @map("content_hash")
  providerContentHash    String?                           @map("provider_content_hash")
  observedAt             DateTime                          @map("observed_at") @db.Timestamptz(6)
  lastObservedAt         DateTime?                         @map("last_observed_at") @db.Timestamptz(6)
  contentUpdatedAt       DateTime?                         @map("content_updated_at") @db.Timestamptz(6)
  rawPointer             String?                           @map("raw_pointer")
  metadata               Json
  schemaVersion          Int                               @default(1) @map("schema_version")
  createdAt              DateTime                          @default(now()) @map("created_at") @db.Timestamptz(6)
  feedItems              FeedItem[]
  engagementSnapshot     SourceItemEngagementSnapshot?
  engagementObservations SourceItemEngagementObservation[]
  engagementDailyRollups SourceItemEngagementDailyRollup[]

  @@unique([tenantId, workspaceId, providerKey, providerItemId], map: "source_items_tenant_workspace_provider_item_key")
  @@unique([tenantId, workspaceId, id], map: "source_items_tenant_workspace_id_key")
  @@index([tenantId, workspaceId, sourceBindingId, observedAt])
  @@map("source_items")
}

model SourceCandidateMemory {
  id                    String   @id @db.Uuid
  tenantId              String   @map("tenant_id") @db.Uuid
  workspaceId           String   @map("workspace_id") @db.Uuid
  interestId            String   @map("interest_id") @db.Uuid
  sourceBindingId       String   @map("source_binding_id") @db.Uuid
  providerKey           String   @map("provider_key")
  providerItemId        String   @map("provider_item_id")
  scopeFingerprint      String   @map("scope_fingerprint")
  fingerprint           String   @map("fingerprint")
  contentFingerprint    String?  @map("content_fingerprint")
  engagementFingerprint String?  @map("engagement_fingerprint")
  policyVersion         String   @map("policy_version")
  decision              String
  reasonCode            String   @map("reason_code")
  expiresAt             DateTime @map("expires_at") @db.Timestamptz(6)
  firstSeenAt           DateTime @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt            DateTime @map("last_seen_at") @db.Timestamptz(6)
  seenCount             Int      @default(1) @map("seen_count")
  schemaVersion         Int      @default(1) @map("schema_version")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, workspaceId, interestId, sourceBindingId, providerKey, scopeFingerprint, providerItemId], map: "source_candidate_memory_scope_item_key")
  @@index([tenantId, workspaceId, sourceBindingId, providerKey, scopeFingerprint, expiresAt], map: "source_candidate_memory_active_lookup_idx")
  @@index([expiresAt], map: "source_candidate_memory_expiry_idx")
  @@map("source_candidate_memory")
}

model SourceItemEngagementSnapshot {
  tenantId             String     @map("tenant_id") @db.Uuid
  workspaceId          String     @map("workspace_id") @db.Uuid
  sourceItemId         String     @map("source_item_id") @db.Uuid
  providerKey          String     @map("provider_key")
  score                BigInt?
  comments             BigInt?
  likes                BigInt?
  reposts              BigInt?
  replies              BigInt?
  quotes               BigInt?
  bookmarks            BigInt?
  impressions          BigInt?
  views                BigInt?
  points               BigInt?
  stars                BigInt?
  forks                BigInt?
  starsGained          BigInt?    @map("stars_gained")
  providerRank         Int?       @map("provider_rank")
  upvoteRatioBps       Int?       @map("upvote_ratio_bps")
  metricsHash          String     @map("metrics_hash")
  firstObservedAt      DateTime   @map("first_observed_at") @db.Timestamptz(6)
  lastObservedAt       DateTime   @map("last_observed_at") @db.Timestamptz(6)
  lastChangedAt        DateTime   @map("last_changed_at") @db.Timestamptz(6)
  lastObservationAt    DateTime   @map("last_observation_at") @db.Timestamptz(6)
  nextObservationDueAt DateTime   @map("next_observation_due_at") @db.Timestamptz(6)
  schemaVersion        Int        @default(1) @map("schema_version")
  createdAt            DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  sourceItem           SourceItem @relation(fields: [tenantId, workspaceId, sourceItemId], references: [tenantId, workspaceId, id], onDelete: Cascade, map: "source_item_engagement_snapshots_source_item_scope_fkey")

  @@id([tenantId, workspaceId, sourceItemId], map: "source_item_engagement_snapshots_pkey")
  @@index([tenantId, workspaceId, providerKey, lastObservedAt(sort: Desc)], map: "source_item_engagement_snapshots_provider_observed_idx")
  @@index([tenantId, workspaceId, nextObservationDueAt], map: "source_item_engagement_snapshots_due_idx")
  @@map("source_item_engagement_snapshots")
}

model SourceItemEngagementObservation {
  id              String                      @id @db.Uuid
  tenantId        String                      @map("tenant_id") @db.Uuid
  workspaceId     String                      @map("workspace_id") @db.Uuid
  sourceItemId    String                      @map("source_item_id") @db.Uuid
  providerKey     String                      @map("provider_key")
  sourceBindingId String?                     @map("source_binding_id") @db.Uuid
  scanJobId       String?                     @map("scan_job_id") @db.Uuid
  score           BigInt?
  comments        BigInt?
  likes           BigInt?
  reposts         BigInt?
  replies         BigInt?
  quotes          BigInt?
  bookmarks       BigInt?
  impressions     BigInt?
  views           BigInt?
  points          BigInt?
  stars           BigInt?
  forks           BigInt?
  starsGained     BigInt?                     @map("stars_gained")
  providerRank    Int?                        @map("provider_rank")
  upvoteRatioBps  Int?                        @map("upvote_ratio_bps")
  metricsHash     String                      @map("metrics_hash")
  observedAt      DateTime                    @map("observed_at") @db.Timestamptz(6)
  bucketStartedAt DateTime                    @map("bucket_started_at") @db.Timestamptz(6)
  reason          EngagementObservationReason
  metricsChanged  Boolean                     @map("metrics_changed")
  hasRegression   Boolean                     @default(false) @map("has_regression")
  schemaVersion   Int                         @default(1) @map("schema_version")
  createdAt       DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  sourceItem      SourceItem                  @relation(fields: [tenantId, workspaceId, sourceItemId], references: [tenantId, workspaceId, id], onDelete: Cascade, map: "source_item_engagement_observations_source_item_scope_fkey")

  @@unique([tenantId, workspaceId, sourceItemId, bucketStartedAt], map: "source_item_engagement_observations_bucket_key")
  @@index([tenantId, workspaceId, sourceItemId, observedAt(sort: Desc)], map: "source_item_engagement_observations_item_observed_idx")
  @@index([tenantId, workspaceId, providerKey, observedAt(sort: Desc)], map: "source_item_engagement_observations_provider_observed_idx")
  @@index([tenantId, workspaceId, observedAt(sort: Desc)], map: "source_item_engagement_observations_retention_idx")
  @@map("source_item_engagement_observations")
}

model SourceItemEngagementDailyRollup {
  tenantId           String     @map("tenant_id") @db.Uuid
  workspaceId        String     @map("workspace_id") @db.Uuid
  sourceItemId       String     @map("source_item_id") @db.Uuid
  providerKey        String     @map("provider_key")
  day                DateTime   @db.Date
  sampleCount        Int        @map("sample_count")
  changedSampleCount Int        @map("changed_sample_count")
  regressionCount    Int        @map("regression_count")
  firstObservedAt    DateTime   @map("first_observed_at") @db.Timestamptz(6)
  lastObservedAt     DateTime   @map("last_observed_at") @db.Timestamptz(6)
  compactedThroughAt DateTime   @map("compacted_through_at") @db.Timestamptz(6)
  openingMetrics     Json       @map("opening_metrics")
  closingMetrics     Json       @map("closing_metrics")
  peakMetrics        Json       @map("peak_metrics")
  schemaVersion      Int        @default(1) @map("schema_version")
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  sourceItem         SourceItem @relation(fields: [tenantId, workspaceId, sourceItemId], references: [tenantId, workspaceId, id], onDelete: Cascade, map: "source_item_engagement_daily_rollups_source_item_scope_fkey")

  @@id([tenantId, workspaceId, sourceItemId, day], map: "source_item_engagement_daily_rollups_pkey")
  @@index([tenantId, workspaceId, providerKey, day(sort: Desc)], map: "source_item_engagement_daily_rollups_provider_day_idx")
  @@index([tenantId, workspaceId, day(sort: Desc)], map: "source_item_engagement_daily_rollups_retention_idx")
  @@map("source_item_engagement_daily_rollups")
}

model ScanFailureQueueEntry {
  id                String                 @id @db.Uuid
  tenantId          String                 @map("tenant_id") @db.Uuid
  workspaceId       String                 @map("workspace_id") @db.Uuid
  scanJobId         String                 @map("scan_job_id") @db.Uuid
  interestId        String                 @map("interest_id") @db.Uuid
  sourceBindingId   String                 @map("source_binding_id") @db.Uuid
  scanPolicyId      String                 @map("scan_policy_id") @db.Uuid
  providerKey       String                 @map("provider_key")
  sourceQuery       Json                   @map("source_query")
  correlationId     String                 @map("correlation_id")
  causationId       String                 @map("causation_id")
  attemptNumber     Int                    @map("attempt_number")
