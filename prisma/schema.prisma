generator client {
  provider     = "prisma-client"
  output       = "../prisma/generated/client"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum TopicStatus {
  ENABLED
  DISABLED
  ARCHIVED
}

enum SourceBindingStatus {
  DRAFT
  ENABLED
  PAUSED
  FAILED
}

enum SourceCredentialKind {
  OAUTH2
  API_TOKEN
  BEARER_TOKEN
  APP_OAUTH
}

enum SourceCredentialStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum ScanJobStatus {
  REQUESTED
  ENQUEUED
  SUCCEEDED
  FAILED
  CANCELLED
}

enum FeedItemStatus {
  VISIBLE
  HIDDEN
  TOMBSTONED
}

enum SummaryStatus {
  REQUESTED
  RUNNING
  COMPLETED
  NO_SIGNAL
  FAILED
  REJECTED
}

enum DeliveryStatus {
  QUEUED
  ASSEMBLING
  SUPPRESSED
  SENDING
  DELIVERED
  FAILED_RETRYABLE
  FAILED_TERMINAL
  DEAD_LETTERED
  CANCELLED
}

enum DeliveryDigestStatus {
  ASSEMBLED
  EMPTY
}

enum DigestScheduleStatus {
  ENABLED
  DISABLED
}

enum UserSubscriptionStatus {
  ENABLED
  PAUSED
  CANCELLED
}

enum UserSubscriptionScheduleStatus {
  ENABLED
  DISABLED
}

enum WebhookEndpointStatus {
  ENABLED
  DISABLED
  QUARANTINED
}

enum UsageKind {
  SCAN
  AI_SUMMARY
  DELIVERY
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

enum ScanFailureQueueStatus {
  RETRY_ENQUEUED
  DEAD_LETTERED
}

enum ScanAttemptStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum ApiKeyCredentialStatus {
  ACTIVE
  REVOKED
}

model Tenant {
  id         String      @id @db.Uuid
  slug       String      @unique
  name       String
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime?   @map("deleted_at") @db.Timestamptz(6)
  workspaces Workspace[]
  users      User[]

  @@map("tenants")
}

model Workspace {
  id          String       @id @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  slug        String
  name        String
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?    @map("deleted_at") @db.Timestamptz(6)
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  memberships Membership[]
  topics      Topic[]

  @@unique([tenantId, slug])
  @@index([tenantId, createdAt])
  @@map("workspaces")
}

model User {
  id          String       @id @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  email       String
  displayName String       @map("display_name")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?    @map("deleted_at") @db.Timestamptz(6)
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  memberships Membership[]

  @@unique([tenantId, email])
  @@index([tenantId, createdAt])
  @@map("users")
}

model Membership {
  id          String         @id @db.Uuid
  tenantId    String         @map("tenant_id") @db.Uuid
  workspaceId String         @map("workspace_id") @db.Uuid
  userId      String         @map("user_id") @db.Uuid
  role        MembershipRole
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  user        User           @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([tenantId, workspaceId, userId])
  @@index([tenantId, userId])
  @@map("memberships")
}

model ApiKeyCredential {
  id          String                 @id @db.Uuid
  tenantId    String                 @map("tenant_id") @db.Uuid
  workspaceId String                 @map("workspace_id") @db.Uuid
  name        String
  keyPrefix   String                 @unique @map("key_prefix")
  secretHash  String                 @map("secret_hash")
  scopes      String[]
  status      ApiKeyCredentialStatus @default(ACTIVE)
  createdAt   DateTime               @map("created_at") @db.Timestamptz(6)
  revokedAt   DateTime?              @map("revoked_at") @db.Timestamptz(6)
  updatedAt   DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, workspaceId, createdAt])
  @@index([tenantId, workspaceId, status])
  @@map("api_keys")
}

model Topic {
  id          String      @id @db.Uuid
  tenantId    String      @map("tenant_id") @db.Uuid
  workspaceId String      @map("workspace_id") @db.Uuid
  name        String
  query       String
  status      TopicStatus @default(ENABLED)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?   @map("deleted_at") @db.Timestamptz(6)
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@unique([tenantId, workspaceId, name])
  @@index([tenantId, workspaceId, status, createdAt])
  @@map("topics")
}

model SourceCatalogEntry {
  id                 String              @id @db.Uuid
  providerKey        String              @unique @map("provider_key")
  displayName        String              @map("display_name")
  acquisitionMode    String              @map("acquisition_mode")
  readiness          String
  capabilityProfiles CapabilityProfile[]
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("source_catalog_entries")
}

model CapabilityProfile {
  id            String             @id @db.Uuid
  sourceId      String             @map("source_id") @db.Uuid
  version       Int
  schemaVersion Int                @default(1) @map("schema_version")
  config        Json
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  source        SourceCatalogEntry @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([sourceId, version])
  @@map("capability_profiles")
}

model SourceBinding {
  id                       String              @id @db.Uuid
  tenantId                 String              @map("tenant_id") @db.Uuid
  workspaceId              String              @map("workspace_id") @db.Uuid
  topicId                  String              @map("topic_id") @db.Uuid
  sourceCatalogEntryId     String              @map("source_catalog_entry_id") @db.Uuid
  capabilityProfileVersion Int                 @map("capability_profile_version")
  status                   SourceBindingStatus @default(DRAFT)
  config                   Json
  cursorResetRequestedAt   DateTime?           @map("cursor_reset_requested_at") @db.Timestamptz(6)
  createdAt                DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                DateTime?           @map("deleted_at") @db.Timestamptz(6)

  @@index([tenantId, workspaceId, topicId, status])
  @@map("source_bindings")
}

model SourceCredential {
  id            String                 @id @db.Uuid
  tenantId      String                 @map("tenant_id") @db.Uuid
  workspaceId   String                 @map("workspace_id") @db.Uuid
  providerKey   String                 @map("provider_key")
  kind          SourceCredentialKind
  status        SourceCredentialStatus @default(ACTIVE)
  secretKeyId   String                 @unique @map("secret_key_id")
  secretPreview String                 @map("secret_preview")
  scopes        String[]
  expiresAt     DateTime?              @map("expires_at") @db.Timestamptz(6)
  rotatedAt     DateTime?              @map("rotated_at") @db.Timestamptz(6)
  revokedAt     DateTime?              @map("revoked_at") @db.Timestamptz(6)
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, workspaceId, providerKey, status])
  @@index([tenantId, workspaceId, updatedAt])
  @@map("source_credentials")
}

model SourceCredentialSecret {
  id         String   @id
  algorithm  String
  ciphertext String
  iv         String
  authTag    String   @map("auth_tag")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("source_credential_secrets")
}

model ScanPolicy {
  id               String   @id @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  workspaceId      String   @map("workspace_id") @db.Uuid
  sourceBindingId  String   @map("source_binding_id") @db.Uuid
  intervalSeconds  Int      @map("interval_seconds")
  freshnessSeconds Int      @map("freshness_seconds")
  retryBudget      Int      @map("retry_budget")
  nextRunAt        DateTime @map("next_run_at") @db.Timestamptz(6)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, sourceBindingId])
  @@index([tenantId, workspaceId])
  @@map("scan_policies")
}

model ScanJob {
  id              String        @id @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  workspaceId     String        @map("workspace_id") @db.Uuid
  sourceBindingId String        @map("source_binding_id") @db.Uuid
  scanPolicyId    String        @map("scan_policy_id") @db.Uuid
  status          ScanJobStatus @default(REQUESTED)
  idempotencyKey  String        @map("idempotency_key")
  leasedUntil     DateTime?     @map("leased_until") @db.Timestamptz(6)
  retryCount      Int           @default(0) @map("retry_count")
  failureClass    String?       @map("failure_class")
  requestedAt     DateTime      @map("requested_at") @db.Timestamptz(6)
  enqueuedAt      DateTime?     @map("enqueued_at") @db.Timestamptz(6)
  completedAt     DateTime?     @map("completed_at") @db.Timestamptz(6)
  failureReason   String?       @map("failure_reason")
  correlationId   String?       @map("correlation_id")
  causationId     String?       @map("causation_id")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, workspaceId, status, createdAt])
  @@map("scan_jobs")
}

model ScanSchedulerDecision {
  id                              String    @id @db.Uuid
  tenantId                        String    @map("tenant_id") @db.Uuid
  workspaceId                     String    @map("workspace_id") @db.Uuid
  decisionKey                     String    @map("decision_key")
  scanPolicyId                    String    @map("scan_policy_id") @db.Uuid
  sourceBindingId                 String    @map("source_binding_id") @db.Uuid
  providerKey                     String?   @map("provider_key")
  decision                        String
  reason                          String
  scanJobId                       String?   @map("scan_job_id") @db.Uuid
  policyDueAt                     DateTime  @map("policy_due_at") @db.Timestamptz(6)
  evaluatedAt                     DateTime  @map("evaluated_at") @db.Timestamptz(6)
  nextRunAt                       DateTime  @map("next_run_at") @db.Timestamptz(6)
  configuredIntervalSeconds       Int       @map("configured_interval_seconds")
  effectiveIntervalSeconds        Int?      @map("effective_interval_seconds")
  freshnessSeconds                Int?      @map("freshness_seconds")
  providerMinimumIntervalEnforced Boolean?  @map("provider_minimum_interval_enforced")
  backoffUntil                    DateTime? @map("backoff_until") @db.Timestamptz(6)
  correlationId                   String?   @map("correlation_id")
  causationId                     String?   @map("causation_id")
  createdAt                       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, workspaceId, decisionKey])
  @@index([tenantId, workspaceId, sourceBindingId, evaluatedAt])
  @@index([tenantId, workspaceId, providerKey, evaluatedAt])
  @@index([tenantId, workspaceId, decision, reason, evaluatedAt])
  @@map("scan_scheduler_decisions")
}

model CursorCheckpoint {
  id              String   @id @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  sourceBindingId String   @map("source_binding_id") @db.Uuid
  schemaVersion   Int      @default(1) @map("schema_version")
  cursorPayload   Json     @map("cursor_payload")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, sourceBindingId])
  @@index([tenantId, workspaceId])
  @@map("cursor_checkpoints")
}

model SourceItem {
  id              String   @id @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  sourceBindingId String   @map("source_binding_id") @db.Uuid
  providerKey     String   @map("provider_key")
  providerItemId  String   @map("provider_item_id")
  canonicalUrl    String   @map("canonical_url")
  title           String
  body            String
  authorHandle    String?  @map("author_handle")
  publishedAt     DateTime @map("published_at") @db.Timestamptz(6)
  contentHash     String   @map("content_hash")
  observedAt      DateTime @map("observed_at") @db.Timestamptz(6)
  rawPointer      String?  @map("raw_pointer")
  metadata        Json
  schemaVersion   Int      @default(1) @map("schema_version")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([tenantId, providerKey, providerItemId])
  @@index([tenantId, workspaceId, sourceBindingId, observedAt])
  @@map("source_items")
}

model ScanFailureQueueEntry {
  id                String                 @id @db.Uuid
  tenantId          String                 @map("tenant_id") @db.Uuid
  workspaceId       String                 @map("workspace_id") @db.Uuid
  scanJobId         String                 @map("scan_job_id") @db.Uuid
  topicId           String                 @map("topic_id") @db.Uuid
  sourceBindingId   String                 @map("source_binding_id") @db.Uuid
  scanPolicyId      String                 @map("scan_policy_id") @db.Uuid
  providerKey       String                 @map("provider_key")
  sourceQuery       Json                   @map("source_query")
  correlationId     String                 @map("correlation_id")
  causationId       String                 @map("causation_id")
  attemptNumber     Int                    @map("attempt_number")
  retryBudget       Int                    @map("retry_budget")
  nextAttemptNumber Int?                   @map("next_attempt_number")
  failureReason     String                 @map("failure_reason")
  status            ScanFailureQueueStatus @default(RETRY_ENQUEUED)
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, workspaceId, status, createdAt])
  @@index([tenantId, scanJobId])
  @@map("scan_failure_queue_entries")
}

model ScanAttempt {
  scanJobId         String            @id @map("scan_job_id") @db.Uuid
  tenantId          String            @map("tenant_id") @db.Uuid
  workspaceId       String            @map("workspace_id") @db.Uuid
  sourceBindingId   String            @map("source_binding_id") @db.Uuid
  status            ScanAttemptStatus @default(RUNNING)
  startedAt         DateTime          @map("started_at") @db.Timestamptz(6)
  finishedAt        DateTime?         @map("finished_at") @db.Timestamptz(6)
  fetched           Int               @default(0)
  inserted          Int               @default(0)
  skippedDuplicates Int               @default(0) @map("skipped_duplicates")
  projected         Int               @default(0)
  failureReason     String?           @map("failure_reason")
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, workspaceId, status, startedAt])
  @@map("scan_attempts")
}

model ScanLeaseEntry {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  scanJobId    String   @map("scan_job_id") @db.Uuid
  workerId     String   @map("worker_id")
  fencingToken String   @map("fencing_token")
  leasedAt     DateTime @map("leased_at") @db.Timestamptz(6)
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(6)

  @@unique([tenantId, workspaceId, scanJobId])
  @@index([expiresAt])
  @@map("scan_leases")
}

model FeedItem {
  id               String         @id @db.Uuid
  tenantId         String         @map("tenant_id") @db.Uuid
  workspaceId      String         @map("workspace_id") @db.Uuid
  topicId          String         @map("topic_id") @db.Uuid
  sourceItemId     String         @map("source_item_id") @db.Uuid
  sourceBindingId  String         @map("source_binding_id") @db.Uuid
  providerKey      String         @map("provider_key")
  dedupeKey        String         @map("dedupe_key")
  canonicalUrl     String         @map("canonical_url")
  title            String
  bodyPreview      String         @map("body_preview")
  authorHandle     String?        @map("author_handle")
  publishedAt      DateTime       @map("published_at") @db.Timestamptz(6)
  observedAt       DateTime       @map("observed_at") @db.Timestamptz(6)
  providerMetadata Json?          @map("provider_metadata")
  status           FeedItemStatus @default(VISIBLE)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, topicId, dedupeKey])
  @@index([tenantId, workspaceId, status, createdAt])
  @@index([tenantId, workspaceId, providerKey, observedAt])
  @@map("feed_items")
}

model FeedSignalBaselineSample {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  topicId     String   @map("topic_id") @db.Uuid
  feedItemId  String   @map("feed_item_id") @db.Uuid
  providerKey String   @map("provider_key")
  sourceKey   String   @map("source_key")
  contentType String   @map("content_type")
  strength    Float
  publishedAt DateTime @map("published_at") @db.Timestamptz(6)
  observedAt  DateTime @map("observed_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, workspaceId, feedItemId])
  @@index([tenantId, workspaceId, topicId, observedAt])
  @@index([tenantId, workspaceId, providerKey, contentType, observedAt])
  @@map("feed_signal_baseline_samples")
}

model GitHubRepositoryTrendCandidate {
  id                 String   @id @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  workspaceId        String   @map("workspace_id") @db.Uuid
  topicId            String   @map("topic_id") @db.Uuid
  sourceBindingId    String   @map("source_binding_id") @db.Uuid
  scanJobId          String   @map("scan_job_id") @db.Uuid
  repositoryFullName String   @map("repository_full_name")
  primaryWindow      String   @map("primary_window")
  stars24h           Int      @map("stars_24h")
  stars48h           Int      @default(0) @map("stars_48h")
  stars7d            Int      @map("stars_7d")
  stars30d           Int      @map("stars_30d")
  stars90d           Int      @map("stars_90d")
  rank               Int
  observedAt         DateTime @map("observed_at") @db.Timestamptz(6)
  source             String
  metadata           Json
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([tenantId, workspaceId, scanJobId, repositoryFullName, primaryWindow])
  @@index([tenantId, workspaceId, sourceBindingId, observedAt])
  @@map("github_repository_trend_candidates")
}

model GitHubRepositoryTrendSnapshot {
  id                 String   @id @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  workspaceId        String   @map("workspace_id") @db.Uuid
  repositoryFullName String   @map("repository_full_name")
  repositoryUrl      String   @map("repository_url")
  description        String?
  language           String?
  topics             Json
  license            String?
  totalStars         Int      @map("total_stars")
  stars24h           Int      @map("stars_24h")
  stars48h           Int      @default(0) @map("stars_48h")
  stars7d            Int      @map("stars_7d")
  stars30d           Int      @map("stars_30d")
  stars90d           Int      @map("stars_90d")
  checkedAt          DateTime @map("checked_at") @db.Timestamptz(6)
  source             String
  metadata           Json
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([tenantId, workspaceId, repositoryFullName, checkedAt])
  @@index([tenantId, workspaceId, checkedAt])
  @@map("github_repository_trend_snapshots")
}

model GitHubRepositoryTrendResult {
  id                 String   @id @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  workspaceId        String   @map("workspace_id") @db.Uuid
  topicId            String   @map("topic_id") @db.Uuid
  sourceBindingId    String   @map("source_binding_id") @db.Uuid
  scanJobId          String   @map("scan_job_id") @db.Uuid
  sourceItemId       String   @map("source_item_id") @db.Uuid
  repositoryFullName String   @map("repository_full_name")
  repositoryUrl      String   @map("repository_url")
  primaryWindow      String   @map("primary_window")
  rank               Int
  checkedAt          DateTime @map("checked_at") @db.Timestamptz(6)
  observedAt         DateTime @map("observed_at") @db.Timestamptz(6)
  source             String
  metadata           Json
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([tenantId, workspaceId, scanJobId, repositoryFullName, primaryWindow])
  @@index([tenantId, workspaceId, topicId, checkedAt])
  @@map("github_repository_trend_results")
}

model SummaryArtifact {
  id              String        @id @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  workspaceId     String        @map("workspace_id") @db.Uuid
  topicId         String        @map("topic_id") @db.Uuid
  userId          String?       @map("user_id")
  subscriptionId  String?       @map("subscription_id") @db.Uuid
  status          SummaryStatus @default(COMPLETED)
  schemaVersion   Int           @default(1) @map("schema_version")
  modelVersion    String        @map("model_version")
  promptVersion   String        @map("prompt_version")
  headline        String
  summaryText     String?       @map("summary_text")
  artifactPayload Json          @map("artifact_payload")
  citations       Json
  qualitySignals  Json          @map("quality_signals")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, workspaceId, topicId, status, createdAt])
  @@index([tenantId, workspaceId, userId, topicId, createdAt])
  @@map("summary_artifacts")
}

model SummaryJob {
  id                String        @id @db.Uuid
  tenantId          String        @map("tenant_id") @db.Uuid
