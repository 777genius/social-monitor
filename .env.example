NODE_ENV=development
PORT=3000

POSTGRES_USER=social_monitor
POSTGRES_PASSWORD=social_monitor_local_password
POSTGRES_DB=social_monitor
DATABASE_URL=postgresql://social_monitor:social_monitor_local_password@localhost:5432/social_monitor

REDIS_URL=redis://localhost:6379/0
KAFKA_BROKERS=localhost:9092
RABBITMQ_URL=amqp://social_monitor:social_monitor_local_password@localhost:5672

SOURCE_CONFIG_ENCRYPTION_KEY=...
SOURCE_CONFIG_ENCRYPTION_KEY_ID=local-dev
DELIVERY_WEBHOOK_SECRET_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

MONITORING_PERSISTENCE=in-memory
MONITORING_SCAN_QUEUE=in-memory
FEED_PERSISTENCE=in-memory
SUMMARY_PERSISTENCE=in-memory
SUMMARY_JOB_QUEUE_MODE=in-memory
DELIVERY_PERSISTENCE=in-memory
DELIVERY_WEBHOOK_PROVIDER=in-memory
IDENTITY_PERSISTENCE=in-memory
USAGE_PERSISTENCE=in-memory
INGESTION_SUPPORT_PERSISTENCE=in-memory
INGESTION_WORKER_PERSISTENCE=in-memory
INGESTION_SCAN_QUEUE_READER=in-memory
INGESTION_SCAN_REPORTER=noop
INTELLIGENCE_SUMMARY_QUEUE_READER=in-memory
DELIVERY_ATTEMPT_DISPATCH_TARGET=direct
DELIVERY_ATTEMPT_DISPATCH_QUEUE=in-memory
DELIVERY_ATTEMPT_QUEUE_READER=in-memory

LOCAL_STACK_NAME=social-monitor-local
