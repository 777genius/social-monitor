OPENAI_READER_SUMMARY_TIMEOUT_MS=90000
OPENAI_READER_SUMMARY_MAX_OUTPUT_TOKENS=2500
READER_SUMMARY_EVAL_DATASET_VERSION=reader_summary.eval.mvp.v1
