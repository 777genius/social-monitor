NODE_ENV=development
SOCIAL_MONITOR_RUNTIME_PROFILE=local-dev
TRUSTED_WORKSPACE_ROLE_HEADER=enabled
PORT=3000
SOCIAL_MONITOR_CORS_ORIGINS=http://localhost:53217
SOCIAL_MONITOR_METRICS_MODE=in-memory
SOCIAL_MONITOR_METRICS_CARDINALITY_LIMIT=256
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
OTEL_METRIC_EXPORT_INTERVAL=60000
OTEL_METRIC_EXPORT_TIMEOUT=30000

POSTGRES_USER=social_monitor
POSTGRES_PASSWORD=social_monitor_local_password
POSTGRES_DB=social_monitor
DATABASE_URL=postgresql://social_monitor:social_monitor_local_password@localhost:5432/social_monitor

REDIS_URL=redis://localhost:6379/0
KAFKA_BROKERS=localhost:9092
RABBITMQ_URL=amqp://social_monitor:social_monitor_local_password@localhost:5672
RABBITMQ_DEAD_LETTER_EXCHANGE=social-monitor.commands.dlx
RABBITMQ_QUEUE_TYPE=quorum
RABBITMQ_QUEUE_DELIVERY_LIMIT=20

SOURCE_CONFIG_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
SOURCE_CONFIG_ENCRYPTION_KEY_ID=local-dev
SOURCE_CREDENTIAL_SECRET_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
DELIVERY_WEBHOOK_SECRET_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

MONITORING_PERSISTENCE=in-memory
MONITORING_SCAN_QUEUE=in-memory
FEED_PERSISTENCE=in-memory
RELEVANCE_PERSISTENCE=in-memory
SUMMARY_PERSISTENCE=in-memory
SUMMARY_JOB_QUEUE_MODE=in-memory
SUMMARY_MODEL_PROVIDER=deterministic
OPENAI_API_KEY=
OPENAI_RESPONSES_ENDPOINT_URL=https://api.openai.com/v1/responses
OPENAI_SUMMARY_MODEL=gpt-5.1-mini
OPENAI_SUMMARY_INPUT_COST_USD_PER_MILLION_TOKENS=0
OPENAI_SUMMARY_OUTPUT_COST_USD_PER_MILLION_TOKENS=0
SUMMARY_YOUTUBE_VIDEO_SUMMARY_PROVIDER=disabled
