{
  "schemaVersion": 1,
  "events": [
    {
      "eventType": "monitoring.interest.created",
      "schemaVersion": 1,
      "producer": "monitoring",
      "tenantScoped": true,
      "requiredEnvelopeFields": ["tenantId", "workspaceId", "correlationId"],
      "requiredPayloadFields": ["interestId", "tenantId", "workspaceId", "name", "query"]
    },
    {
      "eventType": "monitoring.source-binding.enabled",
      "schemaVersion": 1,
      "producer": "monitoring",
      "tenantScoped": true,
      "requiredEnvelopeFields": ["tenantId", "workspaceId", "correlationId"],
      "requiredPayloadFields": [
        "sourceBindingId",
        "tenantId",
        "workspaceId",
        "interestId",
        "providerKey",
        "capabilityProfileVersion"
      ]
    },
    {
      "eventType": "monitoring.source-binding.status-changed",
      "schemaVersion": 1,
      "producer": "monitoring",
      "tenantScoped": true,
      "requiredEnvelopeFields": ["tenantId", "workspaceId", "correlationId"],
      "requiredPayloadFields": [
        "sourceBindingId",
        "tenantId",
        "workspaceId",
        "interestId",
        "providerKey",
        "previousStatus",
        "status"
      ]
    },
    {
      "eventType": "monitoring.scan-policy.set",
      "schemaVersion": 1,
      "producer": "monitoring",
      "tenantScoped": true,
      "requiredEnvelopeFields": ["tenantId", "workspaceId", "correlationId"],
      "requiredPayloadFields": [
        "scanPolicyId",
        "tenantId",
        "workspaceId",
        "sourceBindingId",
        "intervalSeconds",
        "freshnessSeconds",
        "retryBudget"
      ]
    },
    {
      "eventType": "monitoring.scan.requested",
      "schemaVersion": 1,
      "producer": "monitoring",
      "tenantScoped": true,
      "requiredEnvelopeFields": ["tenantId", "workspaceId", "correlationId"],
      "requiredPayloadFields": ["scanJobId", "tenantId", "workspaceId", "sourceBindingId", "scanPolicyId", "providerKey"]
    },
    {
      "eventType": "monitoring.source-binding.config-expanded",
      "schemaVersion": 1,
      "producer": "monitoring",
      "tenantScoped": true,
      "requiredEnvelopeFields": ["tenantId", "workspaceId", "correlationId"],
      "requiredPayloadFields": [
        "sourceBindingId",
        "tenantId",
        "workspaceId",
        "interestId",
        "providerKey",
        "topicLabel",
        "recommendationId",
        "changedConfigPaths"
      ]
    },
    {
      "eventType": "monitoring.source-binding.config-expansion-reverted",
      "schemaVersion": 1,
      "producer": "monitoring",
      "tenantScoped": true,
      "requiredEnvelopeFields": ["tenantId", "workspaceId", "correlationId"],
      "requiredPayloadFields": [
        "sourceBindingId",
        "tenantId",
        "workspaceId",
        "interestId",
        "providerKey",
        "topicLabel",
        "recommendationId",
        "restoredConfigPaths"
      ]
    },
    {
      "eventType": "summary.reader-summary-topic-recommendation.decided",
      "schemaVersion": 1,
      "producer": "summary",
      "tenantScoped": true,
      "requiredEnvelopeFields": ["tenantId", "workspaceId", "correlationId"],
      "requiredPayloadFields": [
        "recommendationId",
        "tenantId",
        "workspaceId",
        "topicLabel",
        "status",
        "applicationStatus",
        "reversionStatus"
      ]
    },
    {
      "eventType": "summary.ready",
      "schemaVersion": 1,
      "producer": "summary",
      "tenantScoped": true,
      "requiredEnvelopeFields": ["tenantId", "workspaceId", "correlationId"],
      "requiredPayloadFields": ["summaryJobId", "summaryId", "tenantId", "workspaceId", "interestId", "status"]
    },
    {
      "eventType": "reader_summary.ready",
      "schemaVersion": 1,
      "producer": "summary",
      "tenantScoped": true,
      "requiredEnvelopeFields": ["tenantId", "workspaceId", "correlationId"],
      "requiredPayloadFields": ["readerSummaryJobId", "readerSummaryId", "tenantId", "workspaceId", "status"]
    },
    {
      "eventType": "summary.status.changed.v1",
      "schemaVersion": 1,
      "producer": "delivery",
      "tenantScoped": true,
      "requiredEnvelopeFields": ["tenantId", "workspaceId", "correlationId"],
      "requiredPayloadFields": ["summaryJobId", "summaryId", "tenantId", "workspaceId", "interestId", "status"]
    },
    {
      "eventType": "digest.ready.v1",
      "schemaVersion": 1,
      "producer": "delivery",
      "tenantScoped": true,
      "requiredEnvelopeFields": ["tenantId", "workspaceId", "correlationId"],
      "requiredPayloadFields": ["digestId", "tenantId", "workspaceId"]
    }
  ]
}
