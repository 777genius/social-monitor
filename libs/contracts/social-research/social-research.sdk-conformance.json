{
  "artifactId": "social-research.sdk-conformance.v1",
  "boundaries": {
    "domainInputModel": "SocialSearchIntent",
    "ergonomicInputModel": "SocialResearchRequestInput",
    "mcpAdapterPolicy": "thin_adapter",
    "providerExecutionBoundary": "SourceFetcherPort",
    "sourceSpecificCompilation": "infrastructure_compiler_only"
  },
  "contractArtifacts": {
    "goldenCases": "libs/contracts/social-research/social-research.sdk-cases.json",
    "languageSdkConformanceSuite": "libs/contracts/social-research/social-research.language-sdk-conformance-suite.json",
    "languageSdkManifest": "libs/contracts/social-research/social-research.language-sdk-manifest.json",
    "languageSdkRunnerContract": "libs/contracts/social-research/social-research.language-sdk-runner-contract.json",
