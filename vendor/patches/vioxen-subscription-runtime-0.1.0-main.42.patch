+function strictAuthJsonObject(text: string): Record<string, unknown> {
+  const fail = (): never => { throw new Error("codex_snapshot_identity_invalid"); };
+  if (Buffer.byteLength(text) > 1024 * 1024) fail();
+  const keys: Array<Set<string> | null> = [];
+  const lexemes = text.match(/"(?:[^"\\]|\\.)*"|[{}\[\]:,]|[^\s{}\[\]:,]+/g) ?? [];
+  for (let i = 0; i < lexemes.length; i++) {
+    const word = lexemes[i]!;
+    if (word === "{") keys.push(new Set());
+    else if (word === "[") keys.push(null);
+    else if (word === "}" || word === "]") keys.pop();
+    else if (word.startsWith('"') && lexemes[i + 1] === ":") {
+      const key: unknown = JSON.parse(word);
+      const scope = keys.at(-1);
+      if (!scope || typeof key !== "string" || scope.has(key)) fail();
+      scope!.add(key as string);
+    }
+  }
+  let value: unknown;
+  try { value = JSON.parse(text); } catch { return fail(); }
+  if (!value || typeof value !== "object" || Array.isArray(value)) return fail();
+  return value as Record<string, unknown>;
+}
