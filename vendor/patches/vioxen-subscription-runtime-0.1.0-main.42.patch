+++ b/packages/agent-account-observability/src/providers/codex/CodexAppServerQuotaReaderStrict.ts
@@ -0,0 +1,62 @@
+import { isDeepStrictEqual } from "node:util";
+
+function invalid(): never { throw new Error("codex_native_quota_invalid"); }
+function object(value: unknown): Record<string, unknown> {
+  if (!value || typeof value !== "object" || Array.isArray(value)) return invalid();
+  return value as Record<string, unknown>;
+}
+
+export function strictCodexAccountRead(value: unknown): void {
+  const root = object(value);
+  const account = object(root.account);
+  if (Object.keys(root).some((key) => !["account", "requiresOpenaiAuth"].includes(key))) invalid();
+  if (root.requiresOpenaiAuth !== true || account.type !== "chatgpt" ||
+    typeof account.planType !== "string" || !account.planType ||
+    !(account.email === null || typeof account.email === "string") ||
+    Object.keys(account).some((key) => !["type", "email", "planType"].includes(key))) invalid();
+}
+
+/** Validate the correlated main bucket before permissive diagnostics conversion. */
+export function strictCodexMainRateLimits(value: unknown, now: Date): unknown {
+  const root = object(value);
+  const main = object(root.rateLimits);
+  if (main.limitId !== "codex") invalid();
+  if (Object.keys(root).some((key) => !["rateLimits", "rateLimitsByLimitId", "rateLimitResetCredits"].includes(key)) ||
+    Object.keys(main).some((key) => !["limitId", "limitName", "primary", "secondary", "credits", "individualLimit",
+      "spendControlReached", "planType", "rateLimitReachedType"].includes(key))) invalid();
+  for (const key of ["limitName", "planType"]) {
+    if (main[key] != null && typeof main[key] !== "string") invalid();
+  }
+  if (root.rateLimitsByLimitId != null) {
+    const buckets = object(root.rateLimitsByLimitId);
+    if (!isDeepStrictEqual(buckets.codex, main)) invalid();
+    for (const [key, bucket] of Object.entries(buckets)) {
+      if (object(bucket).limitId !== key) invalid();
+    }
+  }
+  for (const [key, duration] of [["primary", 300], ["secondary", 10080]] as const) {
+    const window = object(main[key]);
+    if (!Number.isInteger(window.usedPercent) || (window.usedPercent as number) < 0 ||
+      (window.usedPercent as number) > 2_147_483_647 ||
+      window.windowDurationMins !== duration || !Number.isSafeInteger(window.resetsAt) ||
+      (window.resetsAt as number) <= now.getTime() / 1000 ||
+      (window.resetsAt as number) > 8_640_000_000_000 ||
+      Object.keys(window).some((field) => !["usedPercent", "windowDurationMins", "resetsAt"].includes(field))) invalid();
+  }
+  if (main.credits != null) {
+    const credits = object(main.credits);
+    if (typeof credits.hasCredits !== "boolean" || typeof credits.unlimited !== "boolean" ||
+      !(credits.balance === null || (typeof credits.balance === "string" && /^\d+(\.\d+)?$/.test(credits.balance)))) invalid();
+  }
+  // Workspace spend-control uncertainty cannot clear the account-wide record.
+  if (main.spendControlReached != null && typeof main.spendControlReached !== "boolean") invalid();
+  if (main.spendControlReached !== false &&
+    !["free", "go", "plus", "pro"].includes(String(main.planType))) invalid();
+  if (main.individualLimit != null || main.spendControlReached === true) invalid();
+  if (main.rateLimitReachedType != null) {
+    if (main.rateLimitReachedType !== "rate_limit_reached" ||
+      ![main.primary, main.secondary].some((window) => (object(window).usedPercent as number) >= 100)) invalid();
+  }
+  // Special-model buckets never become account-wide main-quota evidence.
+  return { rateLimits: main };
+}
