+import { EventEmitter } from "node:events";
+import { PassThrough, Writable } from "node:stream";
+import { mkdir, mkdtemp, readFile, rm, symlink, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { dirname, join } from "node:path";
+import { describe, expect, it } from "vitest";
+import type { spawn } from "node:child_process";
+import { CodexEphemeralSessionMaterializer } from "../../provider-codex/codex-session-materializer";
+import { CodexQuotaSnapshotObservation } from "../adapters/codex-quota-snapshot-observation";
+import { CodexSnapshotObservationStatus as Status } from "../application/codex-account-capacity-rechecker";
+
+const now = new Date("2026-09-09T00:00:00Z");
+function auth(accountId = "A", rotation = "first") {
+  const jwt = ["e30", Buffer.from(JSON.stringify({
+    exp: rotation === "first" ? 2_000_000_000 : 2_000_000_001, email: "same@example.invalid",
+    "https://api.openai.com/auth": { chatgpt_account_id: accountId, chatgpt_user_id: "user-a" },
+  })).toString("base64url"), "c2ln"].join(".");
+  return { auth_mode: "chatgpt", OPENAI_API_KEY: null, last_refresh: now.toISOString(),
+    tokens: { account_id: accountId, id_token: jwt, access_token: jwt, refresh_token: rotation } };
+}
+const quota = () => ({ rateLimits: { limitId: "codex", planType: "plus", spendControlReached: false,
+  primary: { usedPercent: 20, windowDurationMins: 300, resetsAt: now.getTime() / 1000 + 3600 },
+  secondary: { usedPercent: 30, windowDurationMins: 10080, resetsAt: now.getTime() / 1000 + 86400 } } });
+
+type Hooks = {
+  quota?: unknown;
+  account?: unknown;
+  mutate?: (home: string, source: string) => Promise<void>;
+  signal?: Record<string, unknown>;
+  stopFails?: boolean;
+  cleanupFails?: boolean;
+  profileConflict?: boolean;
+  initialAccount?: string;
+  initialMode?: "omitted" | null;
+  lateSignal?: Record<string, unknown>;
+  rpcError?: boolean;
+  hangInitialize?: boolean;
+  effectiveConfigConflict?: boolean;
+};
+async function setup(hooks: Hooks = {}) {
+  const root = await mkdtemp(join(tmpdir(), "native-quota-test-"));
+  const source = join(root, "synthetic-auth.json");
+  const sourceAuth: Record<string, unknown> = auth(hooks.initialAccount);
+  if (hooks.initialMode === "omitted") delete sourceAuth.auth_mode;
+  if (hooks.initialMode === null) sourceAuth.auth_mode = null;
+  await writeFile(source, JSON.stringify(sourceAuth, null, 2));
+  const calls: string[] = [];
+  const homes: string[] = [];
+  const fakeSpawn = ((_command: string, args: string[], options: { env: Record<string, string>; cwd: string }) => {
+    const env = options.env;
+    expect(Object.keys(env).sort()).toEqual(["CODEX_HOME", "HOME", "LANG", "PATH"]);
+    expect(options.cwd).toBe(env.HOME);
+    expect(args.slice(-3)).toEqual(["app-server", "--strict-config", "--stdio"]);
+    homes.push(env.CODEX_HOME!);
+    const config: Record<string, any> = {};
+    for (let i = 0; i < args.length - 3; i += 2) {
+      const override = args[i + 1]!;
+      const at = override.indexOf("=");
+      const path = override.slice(0, at).split(".");
+      let obj = config;
+      for (const key of path.slice(0, -1)) obj = obj[key] ??= {};
+      obj[path.at(-1)!] = JSON.parse(override.slice(at + 1));
+    }
+    // be6e8 ConfigToml rejects reserved IDs and serializes only configured
+    // providers; it never expands the built-in OpenAI provider into this map.
+    if (["openai", "ollama", "lmstudio"].some((id) => id in (config.model_providers ?? {}))) {
+      throw new Error("reserved built-in provider override");
+    }
+    config.model_providers ??= {};
+    const stdout = new PassThrough();
+    const stderr = new PassThrough();
+    const child = Object.assign(new EventEmitter(), {
+      pid: 12345, stdout, stderr, exitCode: null as number | null, signalCode: null as string | null,
+      kill(signal: string) {
+        if (!hooks.stopFails) { this.signalCode = signal; child.emit("exit", null, signal); child.emit("close", null, signal); }
+        return true;
+      },
+    });
+    const stdin = new Writable({
+      write(chunk, _encoding, callback) {
+        callback();
+        void (async () => {
+          const message = JSON.parse(String(chunk));
+          calls.push(message.method);
+          if (hooks.hangInitialize && message.method === "initialize") return;
+          let result: unknown = {};
+          if (message.method === "initialize") {
+            const fileConfig = await readFile(join(env.CODEX_HOME!, "config.toml"), "utf8");
+            expect(fileConfig.includes("model_providers.openai")).toBe(false);
+            const privateAuth = JSON.parse(await readFile(join(env.CODEX_HOME!, "auth.json"), "utf8"));
+            expect(privateAuth.auth_mode).toBe("chatgpt");
+            const catalog = JSON.parse(await readFile(config.model_catalog_json, "utf8"));
+            expect(catalog.models.length).toBeGreaterThan(0);
+          }
+          if (hooks.effectiveConfigConflict) config.model_providers.openai = { env_key: "SYNTHETIC_ALTERNATE_KEY" };
+          if (message.method === "config/read") result = { config };
+          if (message.method === "account/read") {
+            expect(message.params).toEqual({ refreshToken: false });
+            result = hooks.account === undefined ? { requiresOpenaiAuth: true, account: { type: "chatgpt", email: "same@example.invalid", planType: "plus" } } : hooks.account;
+          }
+          if (message.method === "account/rateLimits/read") {
+            if (hooks.mutate) await hooks.mutate(env.CODEX_HOME!, source);
+            if (hooks.signal) stdout.write(JSON.stringify({ id: message.id, ...hooks.signal }) + "\n");
+            result = hooks.quota === undefined ? quota() : hooks.quota;
+          }
+          stdout.write(JSON.stringify(message.method === "account/rateLimits/read" && hooks.rpcError
+            ? { id: message.id, error: { message: "synthetic-secret-rpc-error" } }
+            : { id: message.id, result }) + "\n");
+        })().catch((error) => child.emit("error", error));
+      },
+      final(callback) {
+        callback();
+        if (hooks.lateSignal) stdout.write(JSON.stringify(hooks.lateSignal) + "\n");
+        if (!hooks.stopFails) { child.signalCode = "SIGTERM"; child.emit("exit", null, "SIGTERM"); child.emit("close", null, "SIGTERM"); }
+      },
+    });
+    return Object.assign(child, { stdin });
+  }) as unknown as typeof spawn;
+  const adapter = new CodexQuotaSnapshotObservation({ authJsonPath: source,
+    codexBinaryPath: process.execPath, spawnProcess: fakeSpawn, appServerLaunchMinIntervalMs: 0,
+    materializer: { mode: "ephemeral", materialize: async (input) => {
+      const materialized = await new CodexEphemeralSessionMaterializer().materialize(input);
+      if (hooks.profileConflict) {
+        homes.push(materialized.codexHome);
+        await mkdir(join(materialized.home, ".codex"));
+        await writeFile(join(materialized.home, ".codex", "config.toml"), "model_provider='other'");
+      }
+      return { ...materialized, release: hooks.cleanupFails
+        ? async () => { throw new Error("synthetic-secret-cleanup-error"); } : materialized.release };
+    } },
+  });
+  return { adapter, source, homes, calls, async cleanup() {
+    await rm(root, { recursive: true, force: true });
+    for (const home of homes) await rm(dirname(home), { recursive: true, force: true });
+  } };
+}
+
+describe("native quota snapshot observation", () => {
+  it("binds display-only responses, compaction and same-A rotation in one isolated client", async () => {
+    const test = await setup({ mutate: async (home) => { await writeFile(join(home, "auth.json"), JSON.stringify(auth("A", "rotated"))); } });
+    try {
+      expect(await test.adapter.read({ now, demand: null })).toMatchObject({ status: Status.Bound });
+      expect(test.calls).toEqual(["initialize", "config/read", "account/read", "account/rateLimits/read"]);
+      expect(await readFile(test.source, "utf8")).toContain("first");
+      await expect(readFile(join(test.homes[0]!, "auth.json"))).rejects.toMatchObject({ code: "ENOENT" });
+    } finally { await test.cleanup(); }
+  });
+
+  it.each(["omitted", null] as const)("supports implicit managed mode %s without changing source bytes", async (initialMode) => {
+    for (const rotation of [undefined, "A", "B"] as const) {
+      const test = await setup({ initialMode, ...(rotation ? { mutate: async (home: string) => {
+        const rotated: Record<string, unknown> = auth(rotation, "rotated");
+        delete rotated.OPENAI_API_KEY;
+        rotated.auth_mode = null;
+        await writeFile(join(home, "auth.json"), JSON.stringify(rotated));
+      } } : {}) });
+      try {
+        const baseline = await readFile(test.source, "utf8");
+        expect((await test.adapter.read({ now, demand: null })).status).toBe(rotation === "B" ? Status.Rejected : Status.Bound);
+        expect(await readFile(test.source, "utf8")).toBe(baseline);
+        expect(test.calls).toEqual(["initialize", "config/read", "account/read", "account/rateLimits/read"]);
+      } finally { await test.cleanup(); }
+    }
+  });
+
+  it.each(["B", "source", "config", "missing"])("rejects final %s mutation", async (kind) => {
+    const test = await setup({ mutate: async (home, source) => {
+      if (kind === "B") await writeFile(join(home, "auth.json"), JSON.stringify(auth("B")));
+      if (kind === "source") await writeFile(source, JSON.stringify(auth("B")));
+      if (kind === "config") await writeFile(join(home, "config.toml"), "model_provider='other'");
+      if (kind === "missing") await rm(join(home, "auth.json"));
+    } });
+    try { expect(await test.adapter.read({ now, demand: null })).toMatchObject({ status: Status.Rejected }); }
+    finally { await test.cleanup(); }
+  });
+
+  it.each([null, { requiresOpenaiAuth: true, account: { type: "apiKey" } }])("rejects invalid account branch %j", async (account) => {
+    const test = await setup({ account });
+    try {
+      expect(await test.adapter.read({ now, demand: null })).toMatchObject({ status: Status.Rejected });
+      expect(test.calls).not.toContain("account/rateLimits/read");
+    } finally { await test.cleanup(); }
+  });
+
+  it("invalidates a credential server request whose ID collides with quota", async () => {
+    const test = await setup({ signal: { method: "account/chatgptAuthTokens/refresh", params: { previousAccountId: "A" } } });
+    try { expect(await test.adapter.read({ now, demand: null })).toMatchObject({ status: Status.Rejected }); }
+    finally { await test.cleanup(); }
+  });
+
+  it("retains a live child's home after an unconfirmed stop", async () => {
+    const test = await setup({ stopFails: true });
+    try {
+      expect(await test.adapter.read({ now, demand: null })).toMatchObject({ status: Status.Rejected, reason: "native_snapshot_stop_unconfirmed" });
+      expect(await readFile(join(test.homes[0]!, "auth.json"), "utf8")).toContain("first");
+    } finally { await test.cleanup(); }
+  });
+
+  it("uses different private homes for simultaneous observations", async () => {
+    const left = await setup(); const right = await setup();
+    try {
+      const result = await Promise.all([left.adapter.read({ now, demand: null }), right.adapter.read({ now, demand: null })]);
+      expect(result.map((value) => value.status)).toEqual([Status.Bound, Status.Bound]);
+      expect(left.homes[0]).not.toBe(right.homes[0]);
+    } finally { await left.cleanup(); await right.cleanup(); }
+  });
+  it.each([
+    { cleanupFails: true }, { profileConflict: true }, { effectiveConfigConflict: true }, { rpcError: true },
+    { lateSignal: { method: "account/login/completed", params: { success: true } } },
+    { lateSignal: { method: "account/updated", params: { authMode: null } } },
+  ])("rejects lifecycle/profile/visible error %j without exposing raw errors", async (hooks) => {
+    const test = await setup(hooks);
+    try {
+      const result = await test.adapter.read({ now, demand: null });
+      expect(result.status).toBe(Status.Rejected);
+      expect(JSON.stringify(result)).not.toContain("synthetic-secret");
+      if (hooks.profileConflict) expect(test.calls).toEqual([]);
+      if (hooks.effectiveConfigConflict) expect(test.calls).toEqual(["initialize", "config/read"]);
+      if (hooks.cleanupFails) {
+        expect(result).toMatchObject({ reason: "native_snapshot_cleanup_failed" });
+        await test.adapter.dispose();
+        await expect(readFile(join(test.homes[0]!, "auth.json"))).rejects.toMatchObject({ code: "ENOENT" });
+      }
+    } finally { await test.cleanup(); }
+  });
+
+  it("allows managed plan notifications and unchanged tokens with successful usage", async () => {
+    const test = await setup({ lateSignal: { method: "account/updated", params: { authMode: "chatgpt", planType: "plus" } } });
+    try { expect((await test.adapter.read({ now, demand: null })).status).toBe(Status.Bound); }
+    finally { await test.cleanup(); }
+  });
+
+  it("independently binds different selected accounts sharing one email", async () => {
+    const left = await setup(); const right = await setup({ initialAccount: "B" });
+    try {
+      const a = await left.adapter.read({ now, demand: null });
+      const b = await right.adapter.read({ now, demand: null });
+      expect(a.status).toBe(Status.Bound); expect(b.status).toBe(Status.Bound);
+      if (a.status !== Status.Bound || b.status !== Status.Bound) throw new Error();
+      expect(a.independentAccountKeyHash).not.toBe(b.independentAccountKeyHash);
+    } finally { await left.cleanup(); await right.cleanup(); }
+  });
+
+  it("rejects final source symlinks without launching a provider", async () => {
+    const test = await setup();
+    try {
+      const target = test.source + ".target";
+      await writeFile(target, JSON.stringify(auth()));
+      await rm(test.source); await symlink(target, test.source);
+      expect((await test.adapter.read({ now, demand: null })).status).toBe(Status.Rejected);
+      expect(test.calls).toEqual([]);
+    } finally { await test.cleanup(); }
+  });
+
+  it("stops a hung initialization at the whole-observation deadline", async () => {
+    const test = await setup({ hangInitialize: true });
+    try {
+      expect(await test.adapter.read({ now, demand: null, timeoutMs: 100 })).toMatchObject({ status: Status.Rejected });
+      expect(test.calls).toEqual(["initialize"]);
+      await expect(readFile(join(test.homes[0]!, "auth.json"))).rejects.toMatchObject({ code: "ENOENT" });
+    } finally { await test.cleanup(); }
+  });
+
+});
